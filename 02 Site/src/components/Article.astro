<script>
  // problem cards: a carousel. One card is sharp on the left, the others wait blurred on its right; the arrows (and a click on a card) bring the next one in, and it wraps around.
  const probs = document.querySelector<HTMLElement>(".blk > .probs");
  if (probs) {
    const cards = [...probs.querySelectorAll<HTMLElement>(".prob")], nav = probs.querySelector<HTMLElement>(".probs-nav")!;
    const n = cards.length;
    let active = 0, prev: number[] = [], cw = 0, gapW = 0;
    const L = (a: number, b: number, t: number) => a + (b - a) * t;
    const slot = (i: number) => (i - active + n) % n;
    // x position per slot, so that the VISIBLE gaps are even: the focus card is drawn 6% bigger and the others 6% smaller (both around their centre)
    const x = (s: number) => (s === 0 ? cw * 0.03 : cw * 1.03 + gapW + (s - 1) * (cw * 0.94 + gapW));
    const apply = (first = false) => {
      const now = cards.map((_, i) => slot(i));
      cards.forEach((c, i) => {
        const s = now[i], focus = s === 0;
        const op = focus ? 1 : s === 1 ? .55 : s === 2 ? .45 : .35;
        const sc = focus ? 1.06 : .94;
        const jump = !first && prev.length && Math.abs(s - prev[i]) > 1;
        c.classList.toggle("is-focus", focus);
        c.setAttribute("aria-current", focus ? "true" : "false");
        const place = () => {
          c.style.transform = `translate3d(${x(s).toFixed(1)}px, 0, 0) scale(${sc})`;
          c.style.filter = focus ? "" : "blur(6px)";
          c.style.zIndex = String(10 - s);
        };
        if (jump) { // a card wrapping around fades in at its new place instead of flying across the others
          c.style.transition = "none"; c.style.opacity = "0"; place(); void c.offsetWidth;
          c.style.transition = "transform .8s cubic-bezier(.2,.7,.2,1), opacity .8s ease .2s, filter .8s ease"; c.style.opacity = String(op);
        } else { c.style.transition = first ? "none" : ""; place(); c.style.opacity = String(op); if (first) { void c.offsetWidth; c.style.transition = ""; } }
      });
      prev = now;
    };
    const layout = () => {
      probs.classList.add("is-car");
      // the sharp card starts exactly at the left edge of the text column; the cards behind it keep an even distance and may run past the right edge
      // (the scaling would pull both edges inwards or outwards by 3% of a card, so the cards are shifted by that much)
      const col = probs.parentElement!.getBoundingClientRect(), gap = 56;
      const w = col.width >= 640 ? (col.width - 32) / 2 : col.width; // card width stays as it was; only the distance between the cards grew
      cards.forEach((c) => { c.style.width = w + "px"; c.style.left = col.left + "px"; c.style.height = ""; });
      const h = Math.ceil(Math.max(...cards.map((c) => c.scrollHeight)));
      cards.forEach((c) => (c.style.height = h + "px"));
      cw = w; gapW = gap;
      nav.style.left = col.left + "px";
      const navTop = 44 + h + 40;
      nav.style.top = navTop + "px";
      probs.style.height = navTop + 48 + 32 + "px";
      apply(true);
    };
    let prog = 0; // how far the ring around the next arrow has come (0 to 1); at 1 the next card comes up
    const go = (to: number) => { active = (to + n) % n; apply(); prog = 0; };
    nav.querySelectorAll<HTMLElement>("button").forEach((b) => b.addEventListener("click", () => go(active + Number(b.dataset.dir))));
    cards.forEach((c, i) => c.addEventListener("click", () => { if (i !== active) go(i); }));
    // automatic advance: the ring fills clockwise and stops while the pointer (or keyboard focus) is on the next button, or the cards are off screen
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
      const next = nav.querySelector<HTMLElement>('[data-dir="1"]')!, ring = next.querySelector<SVGCircleElement>("circle")!;
      const C = 2 * Math.PI * 21, SECONDS = 7;
      ring.style.strokeDasharray = String(C);
      let hold = false, seen = false, last = 0;
      next.addEventListener("pointerenter", () => (hold = true)); next.addEventListener("pointerleave", () => (hold = false));
      next.addEventListener("focus", () => (hold = true)); next.addEventListener("blur", () => (hold = false));
      new IntersectionObserver(([e]) => (seen = e.isIntersecting), { threshold: 0.4 }).observe(probs);
      const tick = (t: number) => {
        const dt = Math.min(100, t - (last || t)); last = t;
        if (seen && !hold && !document.hidden) { prog += dt / (SECONDS * 1000); if (prog >= 1) go(active + 1); }
        ring.style.strokeDashoffset = String(C * (1 - prog));
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }
    layout();
    window.addEventListener("resize", layout);
    window.addEventListener("load", layout);
    document.fonts?.ready.then(layout); // card heights depend on the web fonts
  }
