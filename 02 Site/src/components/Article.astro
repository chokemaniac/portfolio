---
import Layout from "../layouts/Layout.astro";
import Cta from "./Cta.astro";
import Txt from "./Txt.astro";
import Roll from "./Roll.astro";
import VayoViz from "./VayoViz.astro";
import { asset, u } from "../data/asset";
import { GH, projects } from "../data/projects";

const { d, related } = Astro.props;
const rel = related.map((k) => projects[k]);
// section navigation on case studies: "Intro" plus one entry per h2, with hand-written short labels (change them here)
const tocLabels = {
  "case-study-viessmann": ["Intro", "Project", "Initial problems", "Solution", "Outcome", "Summary"],
  "case-study-encore": ["Intro", "Project", "Challenge", "Concept", "Solution", "Execution", "Outcome"],
  "case-study-vayo": ["Intro", "Problem", "Research", "Insight", "Making", "Outcome"],
};
const tocIds = d.page.startsWith("case-study")
  ? ["s-intro", ...d.blocks.map((b, i) => (b.t === "h2" ? `s-${i}` : null)).filter(Boolean)]
  : [];
const toc = tocIds.map((id, k) => ({ id, label: tocLabels[d.page]?.[k] ?? id }));
const hasToc = toc.length > 2;
// media sizes come in as [w, h] for the layout blocks 1623+ / 1100 / 800 / 640 / <640 (null = same as the previous block)
const vars = (b, alt) => {
  const r = alt ?? b.r;
  if (!r) return "";
  const names = ["--a0", "--a1", "--a2", "--a3", "--a4"];
  return r.map((x, i) => (x ? `${names[alt ? i + 3 : i]}:${x[0]} / ${x[1]}` : "")).filter(Boolean).join(";") + ";" +
    (b.pos ? `${b.pos[0] != null ? `--p3:${b.pos[0]}%;` : ""}--p4:${b.pos[1]}%;` : "");
};
// mobile type differs per page on the live site
const small = d.page === "case-study-viessmann" || d.page === "case-study-encore";
const mobileType = `--h3m:${small ? 22 : 24}px;--h3ls:${small ? -0.88 : -0.96}px;--iml:${d.page.startsWith("showcase") ? 28 : 30}px`;
// exact gap above each block per layout block (1623+ / 1100 / 800 / 640 / <640), measured on the live site
const bs = (g) => (g ? g.map((x, i) => (x != null ? `--g${i}:${x}px` : "")).filter(Boolean).join(";") : "");
const cs = (g) => (g ? g.map((x, i) => (x != null ? `--c${i}:${x}px` : "")).filter(Boolean).join(";") : "");
---
<Layout title={d.title + " | Mathias Mahling"}>
  {hasToc && (
    <>
      <nav class="toc" aria-label="Sections">
        <ol>
          {toc.map((t) => <li><a href={`#${t.id}`}><i class="dot"></i><span class="lb">{t.label}</span></a></li>)}
          <li class="send"><a href="#contact" data-send><svg class="send-ic" viewBox="0 0 512 512" aria-hidden="true"><!--Font Awesome Free 6.7.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.--><path d="M498.1 5.6c10.1 7 15.4 19.1 13.5 31.2l-64 416c-1.5 9.7-7.4 18.2-16 23s-18.9 5.4-28 1.6L284 427.7l-68.5 74.1c-8.9 9.7-22.9 12.9-35.2 8.1S160 493.2 160 480l0-83.6c0-4 1.5-7.8 4.2-10.8L331.8 202.8c5.8-6.3 5.6-16-.4-22s-15.7-6.4-22-.7L106 360.8 17.7 316.6C7.1 311.3 .3 300.7 0 288.9s5.9-22.8 16.1-28.7l448-256c10.7-6.1 23.9-5.5 34 1.4z"/></svg><span class="lb">Get in touch</span></a></li>
        </ol>
        <div class="toc-tip" aria-hidden="true"><span></span></div>
      </nav>
      <div class="tocm">
        <button class="tocm-b" type="button" aria-expanded="false" aria-haspopup="true">
          <span class="tocm-t"><span>{toc[0].label}</span></span>
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3.5 6l4.5 4.5L12.5 6" /></svg>
        </button>
        <ul class="tocm-l" inert>
          {toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}
        </ul>
      </div>
    </>
  )}
  <div class="wrap" style={mobileType}>
    <header class="ahd" id={hasToc ? "s-intro" : undefined}>
      <span class="pill">{d.tag}</span>
      <h1>{d.title}</h1>
      {d.intro && <p class="intro"><Txt s={d.intro} v={d.variants} /></p>}
    </header>

    <article class="article">
      {d.blocks.map((b, i) => (
        <div class="blk" id={hasToc && b.t === "h2" ? `s-${i}` : undefined} style={bs(b.g)}>
          {b.t === "h2" && b.eyebrow && <section class="howw"><span class="how-e">{b.eyebrow}</span><h2><Txt s={b.text} v={d.variants} /></h2></section>}
          {b.t === "h2" && !b.eyebrow && <h2><Txt s={b.text} v={d.variants} /></h2>}
          {b.t === "h3" && <h3><Txt s={b.text} v={d.variants} /></h3>}
          {b.t === "p" && <p><Txt s={b.text} v={d.variants} /></p>}
          {b.t === "divider" && <div class="divider" aria-hidden="true"></div>}
          {b.t === "summary" && (
            <dl class="sum">{b.rows.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
          )}
          {b.t === "viz" && <VayoViz name={b.name} wide={b.wide} />}
          {b.t === "how" && (
            <section class="howw">
              <span class="how-e">{b.eyebrow}</span>
              <h2>{b.title}</h2>
              <div class="how-g">
                {b.cards.map((c) => (
                  <div class="how-c">
                    <span class="how-s">{c.step}</span>
                    <span class="how-b me">ME</span><p>{c.me}</p>
                    <span class="how-b ai">AI</span><p>{c.ai}</p>
                  </div>
                ))}
              </div>
            </section>
          )}
          {b.t === "problems" && (
            <div class="probs">
              {b.items.map((it) => (
                <article class="prob">
                  <VayoViz name={it.name} />
                  <h3>{it.title}</h3>
                  <p>{it.text}</p>
                </article>
              ))}
            </div>
          )}
          {b.t === "ai" && (
            <aside class="aibox">
              <span class="aibox-p">AI</span>
              <p>{b.text}</p>
            </aside>
          )}
          {b.t === "img" && (
            <>
              <img class={`media ${b.kind} ${b.alt ? "show-d" : ""} ${b.hideMobile ? "hide-m" : ""} ${b.inset ? "inset" : ""}`} src={asset(b.src)} alt=""
                style={`${vars(b)}border-radius:${b.kind === "wide" ? 56 : 16}px`} loading="lazy" />
              {b.alt && <img class={`media ${b.kind} show-m`} src={asset(b.alt.src)} alt="" style={`${vars(b, b.alt.r)}border-radius:56px`} loading="lazy" />}
            </>
          )}
          {b.t === "video" && (
            <video class={`media ${b.kind}`} src={GH + b.mp4} autoplay muted loop playsinline preload="metadata"
              style={`${vars(b)}border-radius:48px`}></video>
          )}
          {b.t === "phones" && (
            <div class="phones">{b.mp4.map((m) => <video src={GH + m} autoplay muted loop playsinline preload="metadata"></video>)}</div>
          )}
          {b.t === "hscroll" && (
            <div class="hscroll">{b.imgs.map((x) => <img src={asset(x)} alt="" width="268" height="550" loading="lazy" />)}</div>
          )}
          {b.t === "masonry" && (
            <div class="masonry">{b.cols.map((col) => (
              <div>{col.map(([src, h, r]) => <img class="media" src={asset(src)} alt="" loading="lazy" style={`${r.map((x, i) => `--a${i}:${x[0]} / ${x[1]}`).join(";")};border-radius:${b.r * 2}px`} />)}</div>
            ))}</div>
          )}
          {b.t === "tools" && (b.flow ? (
            <div class="tools-flow">{b.imgs.map(([src, , , w, h], i) => <img src={asset(src)} alt="" width={w} height={h} style={`--w:${w};--h:${h};--w6:${b.sz?.[i]?.[0][0] ?? w};--h6:${b.sz?.[i]?.[0][1] ?? h};--w3:${b.sz?.[i]?.[1][0] ?? w};--h3:${b.sz?.[i]?.[1][1] ?? h}`} />)}</div>
          ) : (
            <div class="tools-row" data-w={b.w} style={`height:${b.h}px;width:${b.w}px`}>
              {b.imgs.map(([src, x, y, w, h]) => <img src={asset(src)} alt="" style={`left:${x}px;top:${y}px;width:${w}px;height:${h}px`} />)}
            </div>
          ))}
          {b.t === "card" && (
            <div class={`card2 ${b.label === "The client" ? "" : "card2-b"}`}>
              <div>
                <span>{b.label}</span><h2><Txt s={b.title} v={d.variants} /></h2><p><Txt s={b.text} v={d.variants} /></p>
              </div>
              <img src={asset(b.img)} alt="" />
            </div>
          )}
          {b.t === "wins" && (
            <ul class={`wins ${b.items[0].length > 1 ? "wins-long" : ""}`}>
              {b.items.map((it) => <li><b>{it[0]}</b>{it[1] && <p>{it[1]}</p>}</li>)}
            </ul>
          )}
          {b.t === "link" && (
            <a class="live" href={b.href} target="_blank" rel="noopener" style={`--n:${[...b.text].length}`}><Roll text={b.text} /><svg viewBox="0 0 22 28" width="22" height="28" aria-hidden="true"><path d="M1 7H5H6V9H5H2V20H13.25V17V16H15.25V17V21V22H14.25H1H0V21V8V7H1Z" /><path class="arr" d="M10 6H15H16V7V12V13H14V12V9.4375L7.6875 15.7188L7 16.4375L5.5625 15L6.28125 14.3125L12.5625 8H10H9V6H10Z" /></svg></a>
          )}
        </div>
      ))}

      {d.next && (
        <>
          <div class="blk" style={bs(d.gx.next)}><a class="next" href={u(d.next)}>Next project<svg viewBox="0 0 16 13" width="16" height="13" aria-hidden="true"><path d="M15.3901 7.072L9.90135 12.4107L9.29148 13L8.07175 11.8213L8.68161 11.232L12.6996 7.31467H0.860987H0V5.65067H0.860987H12.6996L8.68161 1.768L8.07175 1.17867L9.29148 0L9.90135 0.589333L15.3901 5.89333L16 6.48267L15.3901 7.072Z" /></svg></a></div>
          <div class="blk" style={bs(d.gx.relH)}><h2 class="rel-h">Related projects</h2></div>
          <div class="blk" style={bs(d.gx.rel)}>
            <div class="related">
              {rel.map((p) => (
                <a href={u(p.href)}>
                  <div class="rel-hit">
                    <div class="thumb">
                      {"img" in p.thumb
                        ? <img src={asset(p.thumb.img)} alt="" />
                        : <video src={GH + p.thumb.mp4} autoplay muted loop playsinline preload="metadata"></video>}
                    </div>
                    <span class="k">{p.kind}</span>
                    <h3>{p.title}</h3>
                    <p>{p.text}</p>
                  </div>
                  <span class="go"><Roll text="Check it out" /><img src={asset("5fb239f4237f")} alt="" width="16" height="13" /></span>
                </a>
              ))}
            </div>
          </div>
        </>
      )}
    </article>
  </div>
  <Cta tight style={cs(d.gx.cta)} cls={d.page === "case-study-viessmann" ? "cta-v" : ""} />
</Layout>

<style is:global>
  /* title block (pill, headline, intro) and the article column */
  .ahd { width: min(100%, 808px); margin-inline: auto; padding-top: 49px; color: var(--ink); }
  /* the space above the eyebrow tag is 156px at every desktop width, the same as on tablet (it was 213px; a gradual version was: margin-top: clamp(-8px, calc(-8px + (100vw - 1100px) * 0.090764), 49px)) */
  @media (min-width: 1100px) { .ahd { padding-top: 0; margin-top: -8px; } }
  .article { width: min(100%, 808px); margin-inline: auto; color: var(--ink); }
  .pill { display: inline-block; padding: 4px 7px; border-radius: 6px; background: #9c9bab; color: #fff; font-size: 14px; line-height: 18px; letter-spacing: -.42px; }
  .ahd h1 { font-size: 48px; font-weight: 600; letter-spacing: -1.92px; color: #000; margin-top: 24px; }
  .ahd .intro { font-size: 22px; line-height: 36px; margin-top: 24px; }

  /* every block sits at the exact distance from the previous one that the live site uses (--g0..--g4 per layout block) */
  .blk { margin-top: var(--g1, 0); }
  .blk > * { margin: 0; }
  .article h2 { font-size: 36px; line-height: 46px; font-weight: 600; letter-spacing: -1.44px; }
  .article h3 { font-size: 24px; line-height: 32px; font-weight: 600; letter-spacing: -.96px; }
  .blk > p { white-space: pre-line; font-family: var(--jakarta); font-size: 18px; line-height: 30px; font-weight: 300; color: #000; }

  /* 8px strip of 45deg lines, cut off at both edges of the column so the start and end are filled */
  .blk > .divider { height: 8px; background: url("/assets/divider-hatch.svg") 3px 0 / 6px 6px repeat; }

  /* executive summary: label on the left, answer on the right, hairlines between the rows */
  .blk > .sum { display: grid; }
  .sum > div { display: grid; grid-template-columns: 140px 1fr; gap: 24px; padding: 18px 0; border-top: 1px solid rgba(24, 22, 56, .12); }
  .sum > div:last-child { border-bottom: 1px solid rgba(24, 22, 56, .12); }
  .sum dt { font-size: 14px; line-height: 30px; letter-spacing: -.28px; color: var(--muted); }
  .sum dd { margin: 0; font-family: var(--jakarta); font-size: 18px; line-height: 30px; font-weight: 300; color: #000; }
  @media (max-width: 639px) { .sum > div { grid-template-columns: 1fr; gap: 4px; } .sum dt { line-height: 20px; } }

  /* the four problem cards */
  .probs { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .prob { padding: 12px 12px 30px; border-radius: 32px; corner-shape: squircle; background: #fff; box-shadow: 0 4px 32px rgba(0, 0, 0, .05); }
  .article .prob h3 { margin: 22px 16px 0; font-size: 20px; line-height: 26px; letter-spacing: -.8px; }
  .blk > .probs .prob > p { margin: 8px 16px 0; font-family: var(--jakarta); font-size: 16px; line-height: 26px; font-weight: 300; color: #000; white-space: normal; }
  @media (max-width: 639px) { .probs { grid-template-columns: 1fr; } }
  /* four across once the window is wide enough (each card stays about 290px or more), breaking out of the text column like the wide images do */
  @media (min-width: 1400px) { .blk > .probs { grid-template-columns: repeat(4, 1fr); width: calc(100vw - 2 * var(--pad)); position: relative; left: 50%; transform: translateX(-50%); } }
  @media (min-width: 1623px) { .blk > .probs { width: calc(100vw - 2 * var(--edge)); gap: 32px; } }

  /* "how I worked": what I did and what AI did, per phase. Two columns by two rows, in the width of the text column */
  .howw { width: 100%; }
  .how-e { display: inline-block; padding: 4px 7px; border-radius: 6px; background: rgba(118, 69, 164, .1); color: #7645a4; font-size: 14px; line-height: 18px; letter-spacing: -.42px; }
  .article .howw h2 { margin-top: 20px; }
  .how-g { display: grid; grid-template-columns: repeat(2, 1fr); grid-template-rows: repeat(10, auto); column-gap: 16px; margin-top: 32px; }
  .how-c { display: grid; grid-template-rows: subgrid; grid-row: span 5; padding: 28px 28px 32px; border-radius: 32px; background: #fff; box-shadow: 0 4px 32px rgba(0, 0, 0, .05); transition: transform .5s cubic-bezier(.34, 1.56, .64, 1); }
  .how-c:nth-child(n+3) { margin-top: 16px; }
  .how-s { display: block; font-size: 14px; line-height: 22px; letter-spacing: -.28px; color: #7645a4; }
  .how-b { display: block; width: max-content; align-self: start; justify-self: start; margin-top: 20px; padding: 3px 12px; border-radius: 999px; font-size: 12px; line-height: 18px; font-weight: 600; letter-spacing: .04em; }
  .how-b.me { background: rgba(24, 22, 56, .08); color: var(--ink); } .how-b.ai { background: rgba(118, 69, 164, .12); color: #7645a4; }
  .blk > .howw .how-c p { margin: 12px 0 0; font-family: var(--jakarta); font-size: 16px; line-height: 26px; font-weight: 300; color: #000; white-space: normal; }
  @media (hover: hover) { .how-c:hover { transform: translateY(-4px); } }
  @media (max-width: 639px) { .how-g { grid-template-columns: 1fr; grid-template-rows: none; gap: 16px; } .how-c { display: block; grid-row: auto; padding: 24px 24px 28px; } .how-c:nth-child(n+3) { margin-top: 0; } }
  @media (prefers-reduced-motion: reduce) { .how-c { transition: none; } }

  /* "how AI was involved" callout: a flat tinted bar with a purple edge on the left, an AI pill and the text */
  .aibox { display: flex; gap: 16px; align-items: flex-start; padding: 18px 24px 18px 22px; border-left: 3px solid #7645a4; border-radius: 0 14px 14px 0; background: #efe7f8; color: #000; }
  .aibox-p { flex: none; margin-top: 2px; padding: 3px 14px; border: 1.5px solid rgba(118, 69, 164, .55); border-radius: 999px; background: rgba(118, 69, 164, .1); color: #7645a4; font-size: 12px; line-height: 18px; font-weight: 600; letter-spacing: .04em; }
  .blk > .aibox p { margin: 0; font-family: var(--jakarta); font-size: 17px; line-height: 28px; font-weight: 400; color: #000; white-space: normal; }
  @media (max-width: 639px) { .aibox { flex-direction: column; gap: 10px; padding: 18px 20px; } }

  /* media: aspect ratio per layout block via --a0 (1623+), --a1 (1100), --a2 (800), --a3 (640), --a4 (<640) */
  .media { display: block; width: 100%; object-fit: cover; aspect-ratio: var(--a1); object-position: 50% 50%; }
  .media.wide { max-width: none; width: calc(100vw - 2 * var(--pad)); position: relative; left: 50%; transform: translateX(-50%); }
  /* the diagram has a transparent background and its boxes touch its left and right edges, so from 1100px up it gets room around it (same at every width, so it doesn't change size at a breakpoint) */
  @media (min-width: 1100px) { .article .media.wide.inset { box-sizing: border-box; padding-inline: 48px; object-fit: contain; } }
  .show-m { display: none; }

  .tools-row { position: relative; }
  .tools-row img { position: absolute; max-width: none; }
  .tools-flow { display: flex; flex-wrap: wrap; align-items: center; gap: 28px 32px; }
  .tools-flow img { width: calc(var(--w) * 1px); height: calc(var(--h) * 1px); max-width: none; }

  .phones { display: flex; justify-content: center; gap: 16px; width: min(1001px, calc(100vw - 2 * var(--pad))); position: relative; left: 50%; transform: translateX(-50%); }
  .phones video { flex: 1; min-width: 0; max-width: 323px; aspect-ratio: 323 / 591; border-radius: 24px; object-fit: cover; }
  .hscroll { display: none; }

  .masonry { display: flex; gap: 16px; width: calc(100vw - 2 * var(--pad)); position: relative; left: 50%; transform: translateX(-50%); }
  .masonry > div { flex: 1; display: flex; flex-direction: column; gap: 17px; }
  .masonry img { width: 100%; max-width: none; object-fit: cover; }
  .masonry .media { width: 100%; }

  .card2 { display: flex; gap: 32px; align-items: flex-start; background: #fff; border-radius: 48px; padding: 40px; box-shadow: 0 4px 32px rgba(0, 0, 0, .05); }
  .card2 > div { flex: 1; min-width: 0; }
  .card2 span { display: block; font-size: 17px; letter-spacing: -.68px; color: var(--muted); }
  .article .card2 h2 { font-size: 24px; line-height: 32px; letter-spacing: -.96px; margin: 3px 0 16px; }
  .article .card2-b h2 { margin-top: 7px; }
  .card2 p { font-family: var(--jakarta); font-size: 16px; line-height: 26px; font-weight: 300; color: #000; }
  .card2 img { flex: 1; min-width: 0; aspect-ratio: 3 / 2; height: auto; border-radius: 16px; object-fit: cover; }

  .wins { list-style: none; padding: 0; display: grid; gap: 32px; }
  .wins li { position: relative; padding-left: 23px; }
  .wins li::before { content: ""; position: absolute; left: 0; top: 2px; width: 16px; height: 16px; background: url("/assets/62a09c5607f6d3091dc18c19c2c415caa1aa60a6.svg") center / contain no-repeat; }
  .wins b { display: block; font-family: var(--jakarta); font-size: 16px; line-height: 20px; font-weight: 500; }
  .wins-long { gap: 32px; }
  .wins-long li { padding-left: 0; }
  .wins-long li::before { top: 7px; }
  .wins-long b { font-size: 18px; line-height: 30px; font-weight: 700; padding-left: 23px; }
  .wins-long p { font-family: var(--jakarta); font-size: 18px; line-height: 30px; font-weight: 300; margin-top: 8px; }

  .live { display: inline-flex; align-items: center; gap: 6px; font-size: 22px; font-weight: 600; letter-spacing: -.88px; color: #7645a4; }
  .live svg { width: 22px; height: 28px; fill: currentColor; overflow: visible; }
  /* on hover, once the letters have finished rolling, the arrow pops out of the box twice, pauses, and repeats */
  @media (hover: hover) { .live:hover .arr { animation: arr-pop 2.2s calc((var(--n) - 1) * 18.1ms + .2s) infinite; } }
  @keyframes arr-pop {
    0% { transform: translate(0, 0); animation-timing-function: cubic-bezier(.34, 1.56, .64, 1); }
    5% { transform: translate(2px, -2px); animation-timing-function: cubic-bezier(.4, 0, .2, 1); }
    10% { transform: translate(0, 0); animation-timing-function: cubic-bezier(.34, 1.56, .64, 1); }
    15% { transform: translate(2px, -2px); animation-timing-function: cubic-bezier(.4, 0, .2, 1); }
    20%, 100% { transform: translate(0, 0); }
  }

  .blk > .next { display: flex; align-items: center; justify-content: center; gap: 12px; width: 173px; height: 48px; margin: 0 auto; border-radius: 62px; background: #fff; box-shadow: 0 1px 4px rgba(0, 0, 0, .07); font-size: 16px; font-weight: 600; letter-spacing: -.48px; color: var(--ink); transition: color .3s, box-shadow .3s; }
  .blk > .next svg { flex: none; fill: currentColor; }
  @media (hover: hover) { .blk > .next:hover { color: #7645a4; box-shadow: 0 3px 12px rgba(118, 69, 164, .18); } }
