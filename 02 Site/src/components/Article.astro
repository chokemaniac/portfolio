<script>
  // "40 different steps": a card with the steps per phase, opened by hover, focus or tap
  const t = document.querySelector<HTMLElement>(".steps-t");
  const pop = document.querySelector<HTMLElement>(".steps-pop");
  if (t && pop) {
    const p = pop.parentElement!;
    let timer = 0;
    const place = () => {
      const r = t.getClientRects(), l = r[r.length - 1], pr = p.getBoundingClientRect();
      pop.style.top = l.bottom - pr.top + 8 + "px";
      pop.style.left = Math.max(0, Math.min(l.left - pr.left - 16, pr.width - pop.offsetWidth)) + "px";
    };
    const ind = () => {
      const on = pop.querySelector<HTMLElement>("[role=tab].on"), i = pop.querySelector<HTMLElement>(".steps-ind");
      if (!on || !i) return;
      if (getComputedStyle(on.parentElement!).flexDirection === "row") { const bar = on.parentElement!; bar.scrollTo({ left: on.offsetLeft - 12, behavior: "smooth" }); i.style.height = ""; i.style.width = on.offsetWidth + "px"; i.style.transform = `translateX(${on.offsetLeft}px)`; }
      else { i.style.width = ""; i.style.height = on.offsetHeight + "px"; i.style.transform = `translateY(${on.offsetTop}px)`; }
    };
    const select = (b: HTMLElement) => {
      pop.querySelectorAll<HTMLElement>("[role=tab]").forEach((x) => { x.classList.toggle("on", x === b); x.setAttribute("aria-selected", String(x === b)); });
      pop.querySelectorAll<HTMLElement>("[role=tabpanel]").forEach((u) => (u.hidden = u.dataset.i !== b.dataset.i));
    };
    const show = (on: boolean) => {
      clearTimeout(timer);
      if (on && !pop.classList.contains("open")) select(pop.querySelector<HTMLElement>("[role=tab]")!); // every time the card opens, it starts on the first tab
      pop.classList.toggle("open", on);
      t.setAttribute("aria-expanded", String(on));
      if (on) { place(); ind(); }
    };
    const later = () => { clearTimeout(timer); timer = window.setTimeout(() => show(false), 200); };
    for (const e of [t, pop]) { e.addEventListener("pointerenter", (ev) => { if ((ev as PointerEvent).pointerType === "mouse") show(true); }); e.addEventListener("pointerleave", (ev) => { if ((ev as PointerEvent).pointerType === "mouse") later(); }); }
    pop.addEventListener("click", (e) => {
      const a = (e.target as HTMLElement).closest(".steps-hire");
      if (!a) return;
      e.preventDefault(); show(false);
      document.querySelector<HTMLElement>("[data-send]")?.click(); // the same move as the paper plane in the side menu: scroll to the contact section and open the contact options
    });
    // mouse: hover opens, so a click keeps it open; touch: a tap toggles; keyboard: focus opens it
    let pt = "";
    t.addEventListener("pointerdown", (e) => (pt = e.pointerType));
    t.addEventListener("click", () => show(pt === "mouse" ? true : !pop.classList.contains("open")));
    t.addEventListener("focus", () => { if (t.matches(":focus-visible")) show(true); });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") show(false); });
    document.addEventListener("pointerdown", (e) => { if (!pop.contains(e.target as Node) && e.target !== t) show(false); });
    window.addEventListener("resize", () => pop.classList.contains("open") && place());
    pop.querySelectorAll<HTMLElement>("[role=tab]").forEach((b) => b.addEventListener("click", () => { select(b); ind(); }));
  }
</script>

<script>
