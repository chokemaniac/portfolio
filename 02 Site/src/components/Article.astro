<script>
  // multi-piece tool logos are laid out at a fixed width; shrink them as a unit when the column is narrower
  document.querySelectorAll<HTMLElement>(".tools-row").forEach((el) => {
    const w = Number(el.dataset.w), box = el.parentElement!;
    const fit = () => el.style.setProperty("zoom", String(Math.min(1, box.clientWidth / w)));
    new ResizeObserver(fit).observe(box);
  });
</script>

<script>
  // section navigation: highlights the section being read and jumps to a section on click
  const toc = document.querySelector<HTMLElement>(".toc");
  if (toc) {
    const tocm = document.querySelector<HTMLElement>(".tocm")!;
    const btn = tocm.querySelector<HTMLButtonElement>(".tocm-b")!;
    const list = tocm.querySelector<HTMLElement>(".tocm-l")!;
    const label = tocm.querySelector<HTMLElement>(".tocm-t > span")!;
    const send = toc.querySelector<HTMLAnchorElement>("[data-send]")!;
    const links = [...toc.querySelectorAll<HTMLAnchorElement>("a:not([data-send])"), ...list.querySelectorAll<HTMLAnchorElement>("a")];
    const tip = toc.querySelector<HTMLElement>(".toc-tip")!;
    const showTip = (a: HTMLElement) => {
      tip.firstElementChild!.textContent = a.textContent;
      tip.style.setProperty("--y", `${a.getBoundingClientRect().top - toc.getBoundingClientRect().top + a.offsetHeight / 2}px`);
      tip.classList.add("show");
    };
    const dots = [...toc.querySelectorAll<HTMLAnchorElement>("a:not([data-send])")];
    const drop = [...list.querySelectorAll<HTMLAnchorElement>("a")];
    const targets = dots.map((a) => document.getElementById(a.getAttribute("href")!.slice(1))!);
    let cur = -1;
    const setOpen = (on: boolean) => {
      tocm.classList.toggle("open", on);
      btn.setAttribute("aria-expanded", String(on));
      list.toggleAttribute("inert", !on);
    };
    const update = () => {
      let i = 0;
      targets.forEach((el, k) => { if (el.getBoundingClientRect().top <= innerHeight * 0.4) i = k; });
      toc.classList.toggle("end", scrollY + innerHeight >= document.documentElement.scrollHeight - 2);
      if (i !== cur) {
        cur = i;
        dots.forEach((a, k) => { a.classList.toggle("on", k === i); a.classList.toggle("past", k < i); });
        drop.forEach((a, k) => a.classList.toggle("on", k === i));
        label.textContent = drop[i].textContent;
        label.classList.remove("sw");
        void label.offsetWidth;
        label.classList.add("sw");
      }
    };
    toc.addEventListener("mouseenter", () => showTip(dots[Math.max(cur, 0)]));
    toc.addEventListener("mouseleave", () => tip.classList.remove("show"));
    // the paper plane scrolls to the very bottom and opens the contact pills there
    send.addEventListener("click", (e) => {
      e.preventDefault();
      glideTo(() => document.documentElement.scrollHeight - innerHeight);
      setTimeout(() => {
        const open = document.querySelector<HTMLButtonElement>(".cta-open");
        if (open && open.getAttribute("aria-expanded") !== "true") open.click();
      }, 0);
    });
    [...dots, send].forEach((a) => {
      a.addEventListener("mouseenter", () => showTip(a));
      a.addEventListener("focus", () => showTip(a));
      a.addEventListener("blur", () => tip.classList.remove("show"));
    });
    // eased scroll: each frame covers a fixed share of the remaining distance, so the speed falls smoothly to zero and the page settles
    // instead of stopping (the browser's own smooth scroll can't be tuned); stops if the visitor scrolls
    let glide = 0;
    const glideTo = (target: () => number) => {
      cancelAnimationFrame(glide);
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) return scrollTo(0, target());
      const stop = () => cancelAnimationFrame(glide);
      addEventListener("wheel", stop, { once: true, passive: true });
      addEventListener("touchstart", stop, { once: true, passive: true });
      const tau = 140; // ms; higher = slower, longer settle
      let pos = scrollY, last = performance.now();
      const step = (now: number) => {
        const dt = Math.min(now - last, 50);
        last = now;
        const to = target();
        const d = to - pos;
        if (Math.abs(d) < 0.5) return scrollTo(0, to);
        pos += d * (1 - Math.exp(-dt / tau));
        scrollTo(0, pos);
        glide = requestAnimationFrame(step);
      };
      glide = requestAnimationFrame(step);
    };
    let tick = 0;
    addEventListener("scroll", () => { cancelAnimationFrame(tick); tick = requestAnimationFrame(update); }, { passive: true });
    addEventListener("resize", update);
    links.forEach((a) => a.addEventListener("click", (e) => {
      e.preventDefault();
      const el = document.getElementById(a.getAttribute("href")!.slice(1))!;
      glideTo(() => (el.id === "s-intro" ? 0 : el.getBoundingClientRect().top + scrollY - parseFloat(getComputedStyle(el).scrollMarginTop)));
      setOpen(false);
    }));
    btn.addEventListener("click", () => setOpen(btn.getAttribute("aria-expanded") !== "true"));
    document.addEventListener("click", (e) => { if (!tocm.contains(e.target as Node)) setOpen(false); });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") setOpen(false); });
    update();
  }
</script>
