---
import Layout from "../layouts/Layout.astro";
import Cta from "./Cta.astro";
import Txt from "./Txt.astro";
import Roll from "./Roll.astro";
import VayoViz from "./VayoViz.astro";
import { asset, u } from "../data/asset";
import { GH, projects } from "../data/projects";

const { d, related } = Astro.props;
const rel = related.map((k) => projects[k]);
// section navigation on case studies: "Intro" plus one entry per h2, with hand-written short labels (change them here)
const tocLabels = {
  "case-study-viessmann": ["Intro", "Project", "Initial problems", "Solution", "Outcome", "Summary"],
  "case-study-encore": ["Intro", "Project", "Challenge", "Concept", "Solution", "Execution", "Outcome"],
  "case-study-vayo": ["Intro", "Approach", "Problem", "Discovery", "Insight", "Design", "Outcome"],
};
const tocIds = d.page.startsWith("case-study")
  ? ["s-intro", ...d.blocks.map((b, i) => (b.t === "h2" || b.t === "how" ? `s-${i}` : null)).filter(Boolean)]
  : [];
const toc = tocIds.map((id, k) => ({ id, label: tocLabels[d.page]?.[k] ?? id }));
const hasToc = toc.length > 2;
// media sizes come in as [w, h] for the layout blocks 1623+ / 1100 / 800 / 640 / <640 (null = same as the previous block)
const vars = (b, alt) => {
  const r = alt ?? b.r;
  if (!r) return "";
  const names = ["--a0", "--a1", "--a2", "--a3", "--a4"];
  return r.map((x, i) => (x ? `${names[alt ? i + 3 : i]}:${x[0]} / ${x[1]}` : "")).filter(Boolean).join(";") + ";" +
    (b.pos ? `${b.pos[0] != null ? `--p3:${b.pos[0]}%;` : ""}--p4:${b.pos[1]}%;` : "");
};
// mobile type differs per page on the live site
const small = d.page === "case-study-viessmann" || d.page === "case-study-encore";
const mobileType = `--h3m:${small ? 22 : 24}px;--h3ls:${small ? -0.88 : -0.96}px;--iml:${d.page.startsWith("showcase") ? 28 : 30}px`;
// exact gap above each block per layout block (1623+ / 1100 / 800 / 640 / <640), measured on the live site
const bs = (g) => (g ? g.map((x, i) => (x != null ? `--g${i}:${x}px` : "")).filter(Boolean).join(";") : "");
const cs = (g) => (g ? g.map((x, i) => (x != null ? `--c${i}:${x}px` : "")).filter(Boolean).join(";") : "");
---
<Layout title={d.title + " | Mathias Mahling"}>
  {hasToc && (
    <>
      <nav class="toc" aria-label="Sections">
        <ol>
          {toc.map((t) => <li><a href={`#${t.id}`}><i class="dot"></i><span class="lb">{t.label}</span></a></li>)}
          <li class="send"><a href="#contact" data-send><svg class="send-ic" viewBox="0 0 512 512" aria-hidden="true"><!--Font Awesome Free 6.7.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.--><path d="M498.1 5.6c10.1 7 15.4 19.1 13.5 31.2l-64 416c-1.5 9.7-7.4 18.2-16 23s-18.9 5.4-28 1.6L284 427.7l-68.5 74.1c-8.9 9.7-22.9 12.9-35.2 8.1S160 493.2 160 480l0-83.6c0-4 1.5-7.8 4.2-10.8L331.8 202.8c5.8-6.3 5.6-16-.4-22s-15.7-6.4-22-.7L106 360.8 17.7 316.6C7.1 311.3 .3 300.7 0 288.9s5.9-22.8 16.1-28.7l448-256c10.7-6.1 23.9-5.5 34 1.4z"/></svg><span class="lb">Get in touch</span></a></li>
        </ol>
        <div class="toc-tip" aria-hidden="true"><span></span></div>
      </nav>
      <div class="tocm">
        <button class="tocm-b" type="button" aria-expanded="false" aria-haspopup="true">
          <span class="tocm-t"><span>{toc[0].label}</span></span>
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3.5 6l4.5 4.5L12.5 6" /></svg>
        </button>
        <ul class="tocm-l" inert>
          {toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}
        </ul>
      </div>
    </>
  )}
  <div class="wrap" style={mobileType}>
    <header class="ahd" id={hasToc ? "s-intro" : undefined}>
      <span class={`pill ${d.page === "case-study-vayo" ? "pill-p" : ""}`}>{d.tag}</span>
      <h1>{d.title}{d.note && <span class="note"><svg viewBox="0 0 96 56" aria-hidden="true"><path d="M92 40C76 52 54 50 48 40C42 30 54 24 59 31C64 38 52 44 42 38C34 33 30 26 28 18"/><path d="M28 18L21 30M28 18L40 25"/></svg><span>{d.note}</span></span>}</h1>
      {d.intro && <p class="intro"><Txt s={d.intro} v={d.variants} /></p>}
    </header>

    <article class="article">
      {d.blocks.map((b, i) => (
        <div class="blk" id={hasToc && (b.t === "h2" || b.t === "how") ? `s-${i}` : undefined} style={bs(b.g)}>
          {b.t === "h2" && b.eyebrow && <section class="howw"><span class="how-e">{b.eyebrow}</span><h2><Txt s={b.text} v={d.variants} /></h2></section>}
          {b.t === "h2" && !b.eyebrow && <h2><Txt s={b.text} v={d.variants} /></h2>}
          {b.t === "h3" && <h3><Txt s={b.text} v={d.variants} /></h3>}
          {b.t === "p" && <p><Txt s={b.text} v={d.variants} /></p>}
          {b.t === "divider" && <div class="divider" aria-hidden="true"></div>}
          {b.t === "summary" && (
            <dl class="sum">{b.rows.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
          )}
          {b.t === "gallery" && (
            <div class="gal" aria-label="Screenshots of the finished app">
              <div class="gal-track">{[0, 1].map((n) => b.items.map((src) => <figure class="gal-i"><img src={src} alt="" width="1800" height="1004" draggable="false" loading="lazy" decoding="async" aria-hidden={n ? "true" : undefined} /><button type="button" class="gal-z" data-full={src.replace("/gallery/", "/gallery/full/")} aria-label="View screenshot full size" tabindex={n ? -1 : undefined} aria-hidden={n ? "true" : undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h6v6M10 20H4v-6M20 4l-7 7M4 20l7-7" /></svg></button></figure>))}</div>
            </div>
          )}
          {b.t === "stats" && (() => { let g = 0; return <dl class="kpis"><svg width="0" height="0" aria-hidden="true" style="position:absolute"><filter id="mb4" x="-10%" y="-5%" width="120%" height="110%"><feGaussianBlur stdDeviation="0 7" /></filter><filter id="mb2" x="-10%" y="-5%" width="120%" height="110%"><feGaussianBlur stdDeviation="0 3.5" /></filter><filter id="mb1" x="-10%" y="-5%" width="120%" height="110%"><feGaussianBlur stdDeviation="0 1.5" /></filter></svg>{b.items.map((x) => <div><dd aria-label={x.n}>{[...x.n].map((c) => { const d = +c, seq = [...Array(20).keys(), ...Array(d + 2).keys()].map((v) => v % 10); return <span class="reel" aria-hidden="true" style={`--n:${20 + d};--g:${g++}`}><span class="fin">{d}</span><span class="st">{seq.map((v) => <i>{v}</i>)}</span></span>; })}</dd><dt>{x.l}</dt></div>)}</dl>; })()}
          {b.t === "kwins" && (
            <div class="kwins">{b.items.map((w) => (
              <figure class="kwin">
                <figcaption>{w.title}</figcaption>
                {w.rows.map((r, n) => (
                  <div class={`wrow ${r.vayo ? "vayo" : ""}`}>
                    <span class="wl">{r.label}</span>
                    <span class="wt"><i class="ext" style={`width:${(r.to / w.max) * 100}%;--n:${n}`}></i><i class="fill" style={`width:${(r.from / w.max) * 100}%;--n:${n}`}></i></span>
                    <b class="wv">{r.text}</b>
                  </div>
                ))}
              </figure>
            ))}</div>
          )}
          {b.t === "viz" && <VayoViz name={b.name} wide={b.wide} eyebrow={b.eyebrow} title={b.title} text={b.text} />}
          {b.t === "how" && (
            <section class="howw">
              <span class="how-e">{b.eyebrow}</span>
              <h2>{b.title}</h2>
              {b.paras && b.paras.map((t) => {
                const rich = t.split(/(\[\[.+?\]\]|\*\*.+?\*\*)/).map((x) => x.startsWith("[[")
                  ? <button type="button" class="steps-t" aria-expanded="false" aria-controls="steps-pop">{x.slice(2, -2)}</button>
                  : x.startsWith("**") ? <strong>{x.slice(2, -2)}</strong>
                  : x);
                return t.includes("[[") && b.steps ? (
                  <div class="steps-w">
                    <p class="how-p">{rich}</p>
                    <div class="steps-pop" id="steps-pop" role="group" aria-label="The steps where AI helped, by phase">
                      <div class="steps-side"><span class="steps-lb" id="steps-lb">Project stage</span><div class="steps-tabs" role="tablist" aria-labelledby="steps-lb"><i class="steps-ind" aria-hidden="true"></i>{b.steps.map((g, i) => <button type="button" role="tab" class={i === 0 ? "on" : ""} aria-selected={i === 0 ? "true" : "false"} data-i={i}>{g.name}<small>{g.items.length}</small></button>)}</div></div>
                      {b.steps.map((g, i) => <div class="steps-panel" role="tabpanel" hidden={i !== 0} data-i={i}><p class="steps-h">{g.title}</p><ul>{g.items.map((it, k) => k < (g.show ?? g.items.length) ? <li>{it}</li> : <li class="blur" aria-hidden="true">{it.replace(/[a-z]/gi, (c) => String.fromCharCode((c <= "Z" ? 65 : 97) + ((c.charCodeAt(0) * 7) % 26)))}</li>)}</ul>{g.items.length > (g.show ?? g.items.length) && <a class="steps-hire" href="#contact"><span class="k">Curious?</span><span class="m">Get in touch</span></a>}</div>)}
                    </div>
                  </div>
                ) : <p class="how-p">{rich}</p>;
              })}
              {b.cards && <div class="how-g">
                {b.cards.map((c) => (
                  <div class="how-c">
                    <span class="how-s">{c.step}</span>
                    <span class="how-b me">ME</span><p>{c.me}</p>
                    <span class="how-b ai">AI</span><p>{c.ai}</p>
                  </div>
                ))}
              </div>}
            </section>
          )}
          {b.t === "problems" && (
            <div class="probs">
              {b.items.map((it) => (
                <article class="prob">
                  <VayoViz name={it.name} />
                  <h3>{it.title.split(/(\S+-\S+)/).map((x) => (x.includes("-") ? <span class="nb">{x}</span> : x))}</h3>
                  <p>{it.text}</p>
                </article>
              ))}
              <div class="probs-nav">
                <button type="button" class="btn btn-icon" data-dir="-1" aria-label="Previous problem"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg></button>
                <button type="button" class="btn btn-icon" data-dir="1" aria-label="Next problem"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg><svg class="ring" viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="21" /></svg></button>
              </div>
            </div>
          )}
          {b.t === "ai" && (
            <aside class="aibox">
              <p><strong>{b.label}:</strong> {b.text.split(/(\*\*[^*]+\*\*)/).map((x) => x.startsWith("**") ? <b>{x.slice(2, -2)}</b> : x)}</p>
            </aside>
          )}
          {b.t === "img" && (
            <>
              <img class={`media ${b.kind} ${b.alt ? "show-d" : ""} ${b.hideMobile ? "hide-m" : ""} ${b.inset ? "inset" : ""}`} src={asset(b.src)} alt=""
                style={`${vars(b)}border-radius:${b.kind === "wide" ? 56 : 16}px`} loading="lazy" />
              {b.alt && <img class={`media ${b.kind} show-m`} src={asset(b.alt.src)} alt="" style={`${vars(b, b.alt.r)}border-radius:56px`} loading="lazy" />}
            </>
          )}
          {b.t === "video" && (
            <video class={`media ${b.kind}`} src={GH + b.mp4} autoplay muted loop playsinline preload="metadata"
              style={`${vars(b)}border-radius:48px`}></video>
          )}
          {b.t === "phones" && (
            <div class="phones">{b.mp4.map((m) => <video src={GH + m} autoplay muted loop playsinline preload="metadata"></video>)}</div>
          )}
          {b.t === "hscroll" && (
            <div class="hscroll">{b.imgs.map((x) => <img src={asset(x)} alt="" width="268" height="550" loading="lazy" />)}</div>
          )}
          {b.t === "masonry" && (
            <div class="masonry">{b.cols.map((col) => (
              <div>{col.map(([src, h, r]) => <img class="media" src={asset(src)} alt="" loading="lazy" style={`${r.map((x, i) => `--a${i}:${x[0]} / ${x[1]}`).join(";")};border-radius:${b.r * 2}px`} />)}</div>
            ))}</div>
          )}
          {b.t === "chips" && <ul class="chips">{b.items.map((t) => typeof t === "string" ? <li>{t}</li> : <li>{t.logo && <img src={u(t.logo)} alt="" />}{t.text}</li>)}</ul>}
          {b.t === "tools" && (b.flow ? (
            <div class="tools-flow">{b.imgs.map(([src, , , w, h], i) => <img src={asset(src)} alt="" width={w} height={h} style={`--w:${w};--h:${h};--w6:${b.sz?.[i]?.[0][0] ?? w};--h6:${b.sz?.[i]?.[0][1] ?? h};--w3:${b.sz?.[i]?.[1][0] ?? w};--h3:${b.sz?.[i]?.[1][1] ?? h}`} />)}</div>
          ) : (
            <div class="tools-row" data-w={b.w} style={`height:${b.h}px;width:${b.w}px`}>
              {b.imgs.map(([src, x, y, w, h]) => <img src={asset(src)} alt="" style={`left:${x}px;top:${y}px;width:${w}px;height:${h}px`} />)}
            </div>
          ))}
          {b.t === "card" && (
            <div class={`card2 ${b.label === "The client" ? "" : "card2-b"}`}>
              <div>
                <span>{b.label}</span><h2><Txt s={b.title} v={d.variants} /></h2><p><Txt s={b.text} v={d.variants} /></p>
              </div>
              <img src={asset(b.img)} alt="" />
            </div>
          )}
          {b.t === "wins" && (
            <ul class={`wins ${b.items[0].length > 1 ? "wins-long" : ""}`}>
              {b.items.map((it) => <li><b>{it[0]}</b>{it[1] && <p>{it[1]}</p>}</li>)}
            </ul>
          )}
          {b.t === "link" && (
            <a class="live" href={b.href} target="_blank" rel="noopener" style={`--n:${[...b.text].length}`}><Roll text={b.text} /><svg viewBox="0 0 22 28" width="22" height="28" aria-hidden="true"><path d="M1 7H5H6V9H5H2V20H13.25V17V16H15.25V17V21V22H14.25H1H0V21V8V7H1Z" /><path class="arr" d="M10 6H15H16V7V12V13H14V12V9.4375L7.6875 15.7188L7 16.4375L5.5625 15L6.28125 14.3125L12.5625 8H10H9V6H10Z" /></svg></a>
          )}
        </div>
      ))}

      {d.next && (
        <>
          <div class="blk" style={bs(d.gx.next)}><a class="next" href={u(d.next)}>Next project<svg viewBox="0 0 16 13" width="16" height="13" aria-hidden="true"><path d="M15.3901 7.072L9.90135 12.4107L9.29148 13L8.07175 11.8213L8.68161 11.232L12.6996 7.31467H0.860987H0V5.65067H0.860987H12.6996L8.68161 1.768L8.07175 1.17867L9.29148 0L9.90135 0.589333L15.3901 5.89333L16 6.48267L15.3901 7.072Z" /></svg></a></div>
          <div class="blk" style={bs(d.gx.relH)}><h2 class="rel-h">Related projects</h2></div>
          <div class="blk" style={bs(d.gx.rel)}>
            <div class="related">
              {rel.map((p) => (
                <a href={u(p.href)}>
                  <div class="rel-hit">
                    <div class="thumb">
                      {"img" in p.thumb
                        ? <img src={asset(p.thumb.img)} alt="" />
                        : <video src={GH + p.thumb.mp4} autoplay muted loop playsinline preload="metadata"></video>}
                    </div>
                    <span class="k">{p.kind}</span>
                    <h3>{p.title}</h3>
                    <p>{p.text}</p>
                  </div>
                  <span class="go"><Roll text="Check it out" /><img src={asset("5fb239f4237f")} alt="" width="16" height="13" /></span>
                </a>
              ))}
            </div>
          </div>
        </>
      )}
    </article>
  </div>
  <Cta tight style={cs(d.gx.cta)} cls={d.page === "case-study-viessmann" ? "cta-v" : ""} />
</Layout>

<style is:global>
  /* title block (pill, headline, intro) and the article column */
  .ahd { width: min(100%, 808px); margin-inline: auto; padding-top: 49px; color: var(--ink); }
  /* the space above the eyebrow tag is 156px at every desktop width, the same as on tablet (it was 213px; a gradual version was: margin-top: clamp(-8px, calc(-8px + (100vw - 1100px) * 0.090764), 49px)) */
  @media (min-width: 1100px) { .ahd { padding-top: 0; margin-top: -8px; } }
  .article { width: min(100%, 808px); margin-inline: auto; color: var(--ink); }
  .pill { display: inline-block; padding: 4px 7px; border-radius: 6px; background: #9c9bab; color: #fff; font-size: 14px; line-height: 18px; letter-spacing: -.42px; }
  .pill.pill-p { background: rgba(118, 69, 164, .1); color: #7645a4; } /* Vayo page: same purple tag as the section eyebrows */
  .ahd h1 { font-size: 48px; font-weight: 600; letter-spacing: -1.92px; color: #000; margin-top: 24px; }
  /* handwritten note after the headline, with a doodle arrow pointing back at it */
  .ahd h1 .note { display: inline-flex; align-items: flex-end; gap: 4px; margin: 0 0 0 14px; vertical-align: bottom; color: #7645a4; font-family: "Caveat", cursive; font-weight: 600; font-size: 40px; line-height: 1; letter-spacing: -1.6px; transform: rotate(-4deg); transform-origin: left bottom; white-space: nowrap; }
  @media (min-width: 640px) { .ahd h1 .note { margin-right: -64px; } } /* the headline keeps 64px free on the right; the note may reach into it */
  .ahd h1 .note svg { width: 84px; height: 49px; margin-bottom: 10px; fill: none; stroke: currentColor; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .ahd .intro { font-size: 22px; line-height: 36px; margin-top: 24px; }

  /* every block sits at the exact distance from the previous one that the live site uses (--g0..--g4 per layout block) */
  .blk { margin-top: var(--g1, 0); }
  .blk > * { margin: 0; }
  .article h2 { font-size: 36px; line-height: 46px; font-weight: 600; letter-spacing: -1.44px; }
  .article h3 { font-size: 24px; line-height: 32px; font-weight: 600; letter-spacing: -.96px; }
  /* headlines keep 64px free on the right, so they wrap to a second line a little sooner (not on phones) */
  @media (min-width: 640px) { .ahd h1, .article .blk > h2, .article .blk > h3, .howw h2 { padding-right: 64px; } }
  .blk > p { white-space: pre-line; font-family: var(--jakarta); font-size: 18px; line-height: 30px; font-weight: 300; color: #000; }

  /* 8px strip of 45deg lines, cut off at both edges of the column so the start and end are filled */
  /* full-width screenshot strip: moved by script (auto-roll, drag, trackpad, scroll parallax) */
  .blk > .gal { position: relative; left: 50%; transform: translateX(-50%); width: 100vw; overflow: hidden; cursor: grab; touch-action: pan-y; user-select: none; -webkit-user-select: none; }
  .gal.drag { cursor: grabbing; }
  .gal-track { display: flex; gap: 24px; width: max-content; will-change: transform; }
  .gal-i { position: relative; flex: none; margin: 0; }
  .gal-track img { display: block; height: clamp(200px, 26vw, 420px); width: auto; aspect-ratio: 2944 / 1642; pointer-events: none; }
  .gal-z { position: absolute; right: 16px; bottom: 16px; display: grid; place-items: center; width: 40px; height: 40px; padding: 0; border: 0; border-radius: 50%; background: #fff; color: var(--ink); box-shadow: 0 2px 10px rgba(24, 22, 56, .18); cursor: pointer; opacity: 0; transform: scale(.85); transition: opacity .25s, transform .25s, color .25s; }
  .gal-z svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .gal-i:hover .gal-z, .gal-z:focus-visible { opacity: 1; transform: none; }
  .gal-z:hover { color: #7645a4; }
  @media (hover: none) { .gal-z { opacity: 1; transform: none; } }
  .gal-box { position: fixed; inset: 0; z-index: 1000; display: grid; place-items: center; padding: 40px; background: rgba(255, 255, 255, .72); -webkit-backdrop-filter: blur(28px); backdrop-filter: blur(28px); opacity: 0; visibility: hidden; transition: opacity .35s, visibility .35s; cursor: zoom-out; }
  .gal-box.open { opacity: 1; visibility: visible; }
  .gal-box img { grid-area: 1 / 1; max-width: calc(100vw - 80px); max-height: calc(100vh - 80px); max-height: calc(100dvh - 80px); width: auto; height: auto; filter: drop-shadow(0 24px 60px rgba(24, 22, 56, .25)) drop-shadow(0 4px 14px rgba(24, 22, 56, .12)); transform: scale(.96); transition: transform .45s cubic-bezier(.2, .7, .2, 1); }
  .gal-box.open img { transform: none; }
  .gal-box .btn { position: absolute; z-index: 1; }
  .gal-box .gal-x { top: 20px; right: 20px; } .gal-box .gal-p { left: 20px; top: 50%; margin-top: -24px; } .gal-box .gal-n { right: 20px; top: 50%; margin-top: -24px; }
  .gal-box .btn svg { width: 24px; height: 24px; fill: none; stroke: var(--ink); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: stroke .3s; }
  @media (hover: hover) { .gal-box .btn:hover svg { stroke: #7645a4; } }
  /* close icon: Font Awesome Free 6.7.2 "xmark" (https://fontawesome.com/license/free), a filled shape */
  .gal-box .gal-x svg { width: auto; height: 20px; fill: var(--ink); stroke: none; transition: fill .3s; }
  @media (hover: hover) { .gal-box .gal-x:hover svg { fill: #7645a4; } }
  .gal-box .btn:focus-visible { outline: 2px solid #7645a4; outline-offset: 2px; }
  /* key wins: each diagram compares MyMaps with Vayo. The solid bar runs to the lower number, the light part to the upper number of the range */
