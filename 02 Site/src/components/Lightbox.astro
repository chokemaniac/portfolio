---
// Pictures in the same overlay as the screenshot gallery on the case studies: white blurred backdrop, a round close button.
// A link with data-lightbox opens in it. data-lightbox="a.jpg|b.jpg" opens a group: the first picture sits on the left with the next one
// peeking in from the right edge, and the arrows slide over to it.
---
<style is:global>
  .lb-box { position: fixed; inset: 0; z-index: 1000; background: rgba(255, 255, 255, .72); -webkit-backdrop-filter: blur(28px); backdrop-filter: blur(28px); opacity: 0; visibility: hidden; transition: opacity .35s, visibility .35s; cursor: zoom-out; overflow: hidden; }
  .lb-box.open { opacity: 1; visibility: visible; }
  .lb-track { position: absolute; left: 0; top: 0; bottom: 0; display: flex; align-items: center; gap: 24px; will-change: transform; transition: transform .6s cubic-bezier(.2, .7, .2, 1); pointer-events: none; }
  .lb-track.still { transition: none; }
  .lb-track img { flex: none; display: block; filter: drop-shadow(0 24px 60px rgba(24, 22, 56, .25)) drop-shadow(0 4px 14px rgba(24, 22, 56, .12)); opacity: .5; transition: opacity .6s; pointer-events: auto; cursor: pointer; }
  .lb-track img.on { opacity: 1; cursor: zoom-out; }
  .lb-box .btn { position: absolute; z-index: 1; }
  .lb-box .lb-x { top: 20px; right: 20px; } .lb-box .lb-p { left: 20px; top: 50%; margin-top: -24px; } .lb-box .lb-n { right: 20px; top: 50%; margin-top: -24px; }
  .lb-box .btn[hidden] { display: none; }
  .lb-box .btn svg { width: 24px; height: 24px; fill: none; stroke: var(--ink); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: stroke .3s; }
  .lb-box .lb-x svg { width: auto; height: 20px; fill: var(--ink); stroke: none; transition: fill .3s; }
  @media (hover: hover) { .lb-box .btn:hover svg { stroke: #7645a4; } .lb-box .lb-x:hover svg { fill: #7645a4; } }
  .lb-box .btn:focus-visible { outline: 2px solid #7645a4; outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { .lb-track, .lb-track img { transition: none; } }
</style>

<script>
  const box = document.createElement("div");
  box.className = "lb-box"; box.setAttribute("role", "dialog"); box.setAttribute("aria-modal", "true"); box.setAttribute("aria-label", "Pictures, full size");
  // close icon: Font Awesome Free 6.7.2 "xmark" (https://fontawesome.com/license/free)
  box.innerHTML = '<div class="lb-track"></div><button type="button" class="btn btn-icon lb-x" aria-label="Close"><svg viewBox="0 0 384 512" aria-hidden="true"><path d="M342.6 150.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L192 210.7 86.6 105.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L146.7 256 41.4 361.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0L192 301.3 297.4 406.6c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L237.3 256 342.6 150.6z" /></svg></button><button type="button" class="btn btn-icon lb-p" aria-label="Previous page"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" /></svg></button><button type="button" class="btn btn-icon lb-n" aria-label="Next page"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></button>';
  document.body.append(box);
  const track = box.querySelector<HTMLElement>(".lb-track")!, prevBtn = box.querySelector<HTMLButtonElement>(".lb-p")!, nextBtn = box.querySelector<HTMLButtonElement>(".lb-n")!;
  let imgs: HTMLImageElement[] = [], idx = 0, from: HTMLElement | null = null;

  // sizes every picture to fit the window, then slides the track so the active one is in place:
  // first on the left, last on the right (the neighbour peeks in at the edge), one alone in the middle
  const layout = () => {
    const vw = innerWidth, vh = innerHeight, small = vw < 700, m = small ? 16 : 40, peek = small ? 44 : 136, gap = 24;
    const maxW = imgs.length > 1 ? vw - m - gap - peek : vw - 2 * m, maxH = vh - 2 * m;
    const w = imgs.map((im) => { const a = (im.naturalWidth || 3) / (im.naturalHeight || 2), width = Math.min(maxW, maxH * a, im.naturalWidth || 1e9); im.style.width = width + "px"; im.style.height = width / a + "px"; return width; });
    const left = w.map((_, i) => w.slice(0, i).reduce((s, x) => s + x + gap, 0));
    const off = imgs.length === 1 ? (vw - w[0]) / 2 : idx === 0 ? m : idx === imgs.length - 1 ? vw - m - left[idx] - w[idx] : (vw - w[idx]) / 2 - left[idx];
    track.style.transform = `translateX(${off - (imgs.length === 1 ? 0 : 0)}px)`;
    imgs.forEach((im, i) => im.classList.toggle("on", i === idx));
    prevBtn.hidden = idx === 0; nextBtn.hidden = idx === imgs.length - 1;
  };
  const go = (i: number) => { idx = Math.max(0, Math.min(imgs.length - 1, i)); layout(); };
  const close = () => { box.classList.remove("open"); document.body.style.overflow = ""; from?.focus(); };
  const open = (srcs: string[], opener: HTMLElement) => {
    from = opener; idx = 0; track.classList.add("still"); track.replaceChildren();
    imgs = srcs.map((s, i) => { const im = new Image(); im.alt = ""; im.draggable = false; im.addEventListener("load", () => { layout(); }); im.addEventListener("click", (e) => { e.stopPropagation(); if (i === idx) close(); else go(i); }); im.src = s; track.append(im); return im; });
    layout(); void track.offsetWidth; track.classList.remove("still");
    box.classList.add("open"); document.body.style.overflow = "hidden";
    box.querySelector<HTMLElement>(".lb-x")!.focus();
  };
  box.addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest("button");
    if (b === prevBtn) return go(idx - 1);
    if (b === nextBtn) return go(idx + 1);
    close();
  });
  addEventListener("keydown", (e) => {
    if (!box.classList.contains("open")) return;
    if (e.key === "Escape") close(); else if (e.key === "ArrowRight") go(idx + 1); else if (e.key === "ArrowLeft") go(idx - 1);
  });
  addEventListener("resize", () => { if (box.classList.contains("open")) { track.classList.add("still"); layout(); void track.offsetWidth; track.classList.remove("still"); } });
  document.addEventListener("click", (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>("a[data-lightbox]");
    if (!a) return;
    e.preventDefault();
    open((a.dataset.lightbox || a.href).split("|"), a);
  });
</script>
