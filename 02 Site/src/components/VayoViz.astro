---
// Animated visuals for the Vayo case study. Each one is a fixed-size "stage" built from the Vayo design system
// (src/styles/vayo-ds.css, scoped to .vz) that is scaled to fit its box. They loop on their own, pause when off screen,
// and stand still for visitors who prefer reduced motion. Nothing here scrolls, scrubs or hijacks the page.
import "../styles/vayo-ds.css";
import { u } from "../data/asset";
const { name, wide = false, eyebrow = "", title = "", text = "" } = Astro.props;
const im = (f) => u(`/vayo/img/${f}.jpg`);

// aspect ratio per layout block (1623+ / 1100 / 800 / 640 / <640), same variables the image blocks use
const ar = (r) => r.map((x, i) => `--a${i}:${x[0]} / ${x[1]}`).join(";");
const RW = ar([[2160, 1100], [1140, 640], [820, 520], [620, 620], [452, 540]]);
const RS = ar([[2160, 1368], [1140, 722], [820, 520], [620, 1690], [452, 1233]]);
const RC = ar([[808, 525], [808, 525], [808, 525], [620, 430], [452, 400]]);
const RT = ar([[808, 856], [808, 856], [808, 856], [808, 856], [808, 856]]);
const isCard = /^p[1-4]$/.test(name); // the four problem cards: small stages inside white cards
const dims = { hero: [1200, 680], planning: [1200, 680], system: [1200, 760], testapp: [808, 856] };
const [W, H] = isCard ? [400, 300] : dims[name] ?? [800, 520];
const steps = { hero: "5600,5600,5600", finding: "3600,8000,2200", funnel: "", }[name] ?? "";

const PIN = `<svg viewBox="0 0 24 30" aria-hidden="true"><path d="M12 29C5 20 2 15.5 2 11a10 10 0 0 1 20 0c0 4.5-3 9-10 18z"/><circle cx="12" cy="11" r="3.6" fill="#fff"/></svg>`;
const CH = `<span class="tp-i" aria-hidden="true"><svg viewBox="0 0 12 12"><path d="M3 4.5 6 7.5 9 4.5"/></svg></span>`;
const OK = `<svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 6.2 5 8.7 9.5 3.5"/></svg>`;
const NO = `<svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3 3 9 9M9 3 3 9"/></svg>`;
const CROWN = `<svg viewBox="0 0 640 640" aria-hidden="true"><!--Font Awesome Free 7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.--><path d="M345 151.2C354.2 143.9 360 132.6 360 120C360 97.9 342.1 80 320 80C297.9 80 280 97.9 280 120C280 132.6 285.9 143.9 295 151.2L226.6 258.8C216.6 274.5 195.3 278.4 180.4 267.2L120.9 222.7C125.4 216.3 128 208.4 128 200C128 177.9 110.1 160 88 160C65.9 160 48 177.9 48 200C48 221.8 65.5 239.6 87.2 240L119.8 457.5C124.5 488.8 151.4 512 183.1 512L456.9 512C488.6 512 515.5 488.8 520.2 457.5L552.8 240C574.5 239.6 592 221.8 592 200C592 177.9 574.1 160 552 160C529.9 160 512 177.9 512 200C512 208.4 514.6 216.3 519.1 222.7L459.7 267.3C444.8 278.5 423.5 274.6 413.5 258.9L345 151.2z"/></svg>`;
const SPARK = `<svg viewBox="0 0 12 12" aria-hidden="true"><path d="M6 1.2 7.2 4.8 10.8 6 7.2 7.2 6 10.8 4.8 7.2 1.2 6 4.8 4.8Z" fill="currentColor" stroke="none"/></svg>`;
const SPARKS = ["a", "b", "c"].map((c) => `<i class="spk ${c}">${SPARK}</i>`).join("");
const star = (n) => [1, 2, 3, 4, 5].map((i) => `<i class="${i <= n ? "f" : ""}" style="--i:${i}"></i>`).join("");
const MAP = `<svg class="v-bg" viewBox="0 0 800 520" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <rect width="800" height="520" fill="#efede6"/>
  <path d="M-20 20C60 -10 180 10 210 70 230 120 150 150 80 130 20 115-30 90-20 20Z" fill="#dcead3"/>
  <path d="M600 -10C700 -20 790 20 830 70V-10Z" fill="#dcead3"/>
  <path d="M520 430C560 400 650 410 690 450 720 490 660 540 580 530 530 520 500 470 520 430Z" fill="#dcead3"/>
  <path d="M250 300C290 280 340 290 350 330 358 365 320 380 285 372 245 363 225 325 250 300Z" fill="#e4edd9"/>
  <path d="M-30 400C120 340 230 450 380 410 520 372 620 300 840 250" stroke="#c9d9f2" stroke-width="84" fill="none" stroke-linecap="round"/>
  <g stroke="#e3e0d4" fill="none" stroke-width="1.6"><path d="M-20 90C80 110 150 80 260 120 340 148 430 120 520 140"/><path d="M60 -20C90 90 70 170 130 250"/><path d="M380 -20C360 60 400 110 380 190 365 250 430 300 410 360"/><path d="M560 200C640 240 700 230 830 270"/><path d="M180 540C200 470 260 450 300 400"/></g>
  <g stroke="#fff" fill="none" stroke-linecap="round" stroke-linejoin="round">
    <path d="M-20 140C140 120 260 190 400 170 560 148 680 90 830 110" stroke-width="8"/>
    <path d="M120 -20C140 120 90 240 180 340 230 395 300 470 290 540" stroke-width="7"/>
    <path d="M430 -20C410 90 470 170 450 260 432 340 520 430 560 540" stroke-width="7"/>
    <path d="M-20 300C100 310 200 260 320 290 460 325 560 280 650 330 720 368 780 350 830 360" stroke-width="7"/>
    <path d="M650 -20C640 80 700 150 690 240 682 320 740 420 760 540" stroke-width="7"/>
    <path d="M30 520C150 420 260 330 360 250 450 180 540 110 620 -10" stroke-width="6"/>
    <path d="M-20 60C100 80 180 40 300 70 400 95 470 60 560 30" stroke-width="3.5"/>
    <path d="M200 -20C230 80 280 130 340 190 390 240 380 330 420 400 440 440 410 500 400 540" stroke-width="3.5"/>
    <path d="M0 220C80 200 160 230 250 210" stroke-width="3.5"/>
    <path d="M520 190C600 210 640 180 740 200 790 210 810 190 830 180" stroke-width="3.5"/>
    <path d="M300 380C350 360 420 380 470 350" stroke-width="3.5"/>
    <path d="M560 380C620 410 700 400 800 430" stroke-width="3.5"/>
    <path d="M90 440C160 470 240 460 320 500" stroke-width="3.5"/>
    <path d="M720 20C750 90 780 100 830 90" stroke-width="3.5"/>
    <path d="M250 110C290 150 270 200 320 230" stroke-width="3"/>
    <path d="M470 60C500 100 560 90 600 130" stroke-width="3"/>
  </g>
</svg>`;
// the map of the coordinates card: no road ends inside the river (one short road moved onto land, one thin road runs through to the far bank)
const MAP2 = MAP
  .replace('<path d="M300 380C350 360 420 380 470 350" stroke-width="3.5"/>', '<path d="M300 330C350 310 420 330 470 300" stroke-width="3.5"/>')
  .replace('<path d="M180 540C200 470 260 450 300 400"/>', '<path d="M180 540C200 470 260 450 300 400C322 370 336 336 350 300"/>')
  .replace('430 300 410 360"', '430 300 410 360 395 410 425 470 435 540"')
  .replace('<path d="M560 380C620 410 700 400 800 430" stroke-width="3.5"/>', '<path d="M540 425C610 420 700 400 800 430" stroke-width="3.5"/>');
const places = [
  ["Amanohashidate", "Amanohashidate Line, Miyazu", "a1", "Viewpoint", 5],
  ["Chionji Temple", "Monju, Miyazu", "a2", "Temple/Shrine", 5],
  ["Dai Heiwa Kinen Tō", "Osaka Prefecture", "a3", "History/Monument", 4],
  ["Daigo-ji Temple", "Kyoto", "a4", "Temple/Shrine", 5],
  ["Daishō-in Temple", "Itsukushima", "a5", "Temple/Shrine", 4],
  ["Dōtonbori", "Osaka", "s2", "Neighborhood", 4],
];
const heroPins = [[44, 30], [56, 18], [64, 44], [48, 56], [74, 34], [82, 60], [90, 22], [60, 72], [70, 84], [41, 78], [88, 80], [78, 12], [52, 40]];
const colorOf = (i) => (i === 3 || i === 8 ? "var(--pin-green)" : i === 11 ? "var(--pin-gone)" : "var(--rust)");
const newPins = [[58, 28], [66, 58], [80, 47], [50, 70], [86, 36]];
const routePts = [[44, 30], [64, 44], [74, 34], [82, 60]];
// the place glyphs (hotel, landmark, torii gate, binoculars) are the app's own pin symbols, Font Awesome Free 6.7.2 (https://fontawesome.com/license/free)
const IC = {
  hotel: '<svg class="g" viewBox="0 0 512 512" aria-hidden="true"><path d="M0 32C0 14.3 14.3 0 32 0L480 0c17.7 0 32 14.3 32 32s-14.3 32-32 32l0 384c17.7 0 32 14.3 32 32s-14.3 32-32 32l-176 0 0-48c0-26.5-21.5-48-48-48s-48 21.5-48 48l0 48L32 512c-17.7 0-32-14.3-32-32s14.3-32 32-32L32 64C14.3 64 0 49.7 0 32zm96 80l0 32c0 8.8 7.2 16 16 16l32 0c8.8 0 16-7.2 16-16l0-32c0-8.8-7.2-16-16-16l-32 0c-8.8 0-16 7.2-16 16zM240 96c-8.8 0-16 7.2-16 16l0 32c0 8.8 7.2 16 16 16l32 0c8.8 0 16-7.2 16-16l0-32c0-8.8-7.2-16-16-16l-32 0zm112 16l0 32c0 8.8 7.2 16 16 16l32 0c8.8 0 16-7.2 16-16l0-32c0-8.8-7.2-16-16-16l-32 0c-8.8 0-16 7.2-16 16zM112 192c-8.8 0-16 7.2-16 16l0 32c0 8.8 7.2 16 16 16l32 0c8.8 0 16-7.2 16-16l0-32c0-8.8-7.2-16-16-16l-32 0zm112 16l0 32c0 8.8 7.2 16 16 16l32 0c8.8 0 16-7.2 16-16l0-32c0-8.8-7.2-16-16-16l-32 0c-8.8 0-16 7.2-16 16zm144-16c-8.8 0-16 7.2-16 16l0 32c0 8.8 7.2 16 16 16l32 0c8.8 0 16-7.2 16-16l0-32c0-8.8-7.2-16-16-16l-32 0zM328 384c13.3 0 24.3-10.9 21-23.8c-10.6-41.5-48.2-72.2-93-72.2s-82.5 30.7-93 72.2c-3.3 12.8 7.8 23.8 21 23.8l144 0z"/></svg>',
  castle: '<svg class="g" viewBox="0 0 512 512" aria-hidden="true"><path d="M240.1 4.2c9.8-5.6 21.9-5.6 31.8 0l171.8 98.1L448 104l0 .9 47.9 27.4c12.6 7.2 18.8 22 15.1 36s-16.4 23.8-30.9 23.8L32 192c-14.5 0-27.2-9.8-30.9-23.8s2.5-28.8 15.1-36L64 104.9l0-.9 4.4-1.6L240.1 4.2zM64 224l64 0 0 192 40 0 0-192 64 0 0 192 48 0 0-192 64 0 0 192 40 0 0-192 64 0 0 196.3c.6 .3 1.2 .7 1.8 1.1l48 32c11.7 7.8 17 22.4 12.9 35.9S494.1 512 480 512L32 512c-14.1 0-26.5-9.2-30.6-22.7s1.1-28.1 12.9-35.9l48-32c.6-.4 1.2-.7 1.8-1.1L64 224z"/></svg>',
  torii: '<svg class="g" viewBox="0 0 512 512" aria-hidden="true"><path d="M0 80c0 26.5 21.5 48 48 48l16 0 0 64 64 0 0-64 96 0 0 64 64 0 0-64 96 0 0 64 64 0 0-64 16 0c26.5 0 48-21.5 48-48l0-66.6C512 6 506 0 498.6 0c-1.7 0-3.4 .3-5 1l-49 19.6C425.7 28.1 405.5 32 385.2 32L126.8 32c-20.4 0-40.5-3.9-59.4-11.4L18.4 1c-1.6-.6-3.3-1-5-1C6 0 0 6 0 13.4L0 80zM64 288l0 192c0 17.7 14.3 32 32 32s32-14.3 32-32l0-192 256 0 0 192c0 17.7 14.3 32 32 32s32-14.3 32-32l0-192 32 0c17.7 0 32-14.3 32-32s-14.3-32-32-32L32 224c-17.7 0-32 14.3-32 32s14.3 32 32 32l32 0z"/></svg>',
  bino: '<svg class="g" viewBox="0 0 512 512" aria-hidden="true"><path d="M128 32l32 0c17.7 0 32 14.3 32 32l0 32L96 96l0-32c0-17.7 14.3-32 32-32zm64 96l0 320c0 17.7-14.3 32-32 32L32 480c-17.7 0-32-14.3-32-32l0-59.1c0-34.6 9.4-68.6 27.2-98.3C40.9 267.8 49.7 242.4 53 216L60.5 156c2-16 15.6-28 31.8-28l99.8 0zm227.8 0c16.1 0 29.8 12 31.8 28L459 216c3.3 26.4 12.1 51.8 25.8 74.6c17.8 29.7 27.2 63.7 27.2 98.3l0 59.1c0 17.7-14.3 32-32 32l-128 0c-17.7 0-32-14.3-32-32l0-320 99.8 0zM320 64c0-17.7 14.3-32 32-32l32 0c17.7 0 32 14.3 32 32l0 32-96 0 0-32zm-32 64l0 160-64 0 0-160 64 0z"/></svg>',
  car: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 16v-5l2-5h10l2 5v5M3 16h18M7 19v-3M17 19v-3"/></svg>',
  chat: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v11h-8.5L7 19.5V16H4z"/><path d="M9 10.5h.01M12 10.5h.01M15 10.5h.01"/></svg>',
  clock: '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 7v5.2l3 1.8"/></svg>',
  sunset: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 19h18M6.5 19a5.5 5.5 0 0 1 11 0M12 6v3M4.8 10.8l1.6 1.6M19.2 10.8l-1.6 1.6M9 4l3 2 3-2"/></svg>',
  sunrise: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 19h18M6.5 19a5.5 5.5 0 0 1 11 0M12 6V3M4.8 10.8l1.6 1.6M19.2 10.8l-1.6 1.6M9 5l3-2 3 2"/></svg>',
  cal: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5.5" width="16" height="14" rx="2"/><path d="M4 10h16M8.5 3.5v4M15.5 3.5v4"/></svg>',
  eye: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z"/><circle cx="12" cy="12" r="2.8"/></svg>',
  up: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5h14M12 19V9M7.5 13.5 12 9l4.5 4.5"/></svg>',
  arr: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h13M12 7l5 5-5 5M21 5v14"/></svg>',
  dep: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12H8M12 7l-5 5 5 5M3 5v14"/></svg>',
};
const MAP_PLAN = MAP.replace("M-30 400C120 340 230 450 380 410 520 372 620 300 840 250", "M-30 455C140 420 240 470 400 450 540 432 650 440 840 420");
const hm = (m) => `${String(Math.floor(m / 60)).padStart(2, "0")}:${String(m % 60).padStart(2, "0")}`;
// Font Awesome Pro (the app's icon font) can't be published, so the app's own markup keeps its <i class="fa-regular fa-..."> and each one gets an inline SVG drawing.
const FAP = {
  ellipsis: '<circle cx="5" cy="12" r="1.7" fill="currentColor"/><circle cx="12" cy="12" r="1.7" fill="currentColor"/><circle cx="19" cy="12" r="1.7" fill="currentColor"/>',
  "angle-down": '<path d="M6 9l6 6 6-6"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  "location-dot": '<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.3"/>',
  bookmark: '<path d="M7 4h10v16l-5-3.5L7 20z"/>',
  layer: '<path d="M7 3h7l4 4v4M7 3v8M6 15H5a1 1 0 0 0-1 1v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3a1 1 0 0 0-1-1h-1M3 12h2M9 12h2M13 12h2M17 12h2"/>',
  xmark: '<path d="M6 6l12 12M18 6L6 18"/>',
  "arrow-left": '<path d="M19 12H5M11 6l-6 6 6 6"/>',
  "arrow-right": '<path d="M5 12h14M13 6l6 6-6 6"/>',
  check: '<path d="M5 12.5l4.5 4.5L19 7"/>',
  "fill-drip": '<path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"/>',
  camera: '<path d="M4 8h3l1.5-2h7L17 8h3v11H4z"/><circle cx="12" cy="13" r="3.5"/>',
  "circle-info": '<circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.6v.01"/>',
};
const fi = (n) => `<i class="fa-regular fa-${n}"><svg viewBox="0 0 24 24" aria-hidden="true">${FAP[n]}</svg></i>`;
const letters = "ABCDEFGHIJ".split("");
// turn-by-turn lines as MyMaps shows them: the time and distance of a leg sit between the instructions
const steps2 = [["Start southwest on 小松拡幅/琵琶湖西縦貫道路/国道161号", "17.4 km"], ["Take the Wani IC exit", "473 m"], ["Turn left towards 県道311号", "138 m"], ["Turn right onto 県道311号", "3.15 km"], ["Turn right onto レインボーロード/国道477号", "1.74 km"], ["Turn left onto 国道367号", "2.3 km"]];
---
<div class:list={isCard ? ["viz", "pv"] : ["media", wide ? "wide" : "col", "viz"]} data-viz={name} data-w={W} data-h={H} data-align={{ hero: "left", planning: "left", finding: "left" }[name]} style={isCard ? undefined : name === "system" ? RS : name === "testapp" ? RT : wide ? RW : RC} role={name === "system" || name === "testapp" ? "group" : "img"}
  aria-label={{ hero: "Animated preview of the Vayo app: browsing pins, researching, planning a route", problem: "Animation of Google MyMaps running into its limits", testapp: "Animation of the test app checking research, coordinates and photos", funnel: "Animation of planning as a funnel from many finds to a shortlist to routes, merging separate tools into one", finding: "Animation of fixed categories giving way to free research questions whose results land on the map", shortlist: "Animation of keeping or skipping places like swiping, then rating the shortlist", planning: "Animation of a day plan with drive times, a start time and a sunset check", system: "Interactive playground with the Vayo app's own elements: the tabs, the three-dot menu, a pin card, the colors, the plus menu and a filter, in light and dark mode", outcome: "Animation comparing 2 to 3 months of planning with 2 to 3 weeks", p1: "Animation of a MyMaps layer list filling up until MyMaps shows an error that the maximum number of layers is reached", p2: "Animation of a MyMaps directions list where the drive time is buried between turn-by-turn instructions", p3: "Animation of a MyMaps pin photo that breaks because its link no longer works", p4: "Animation of places being copied by hand from other apps onto an empty MyMaps map" }[name]}>
  <div class="stage vz" data-theme="light" data-scene="1" data-steps={steps} style={`--W:${W}px;--H:${H}px`}>

    {name === "hero" && (
      <div class="v-win">
        <div class="v-bar">
          <span class="v-dots"><i></i><i></i><i></i></span>
          <span class="v-title">Show all pins</span>
          <span class="v-tabs"><u></u><b>Browse</b><b>Research</b><b>Plan</b></span>
          <span class="v-filters">
            {["Category", "Origin", "Classification", "Rating"].map((t) => <span class="tp tp-btn tertiary s32 td"><span class="tp-btxt">{t}</span><Fragment set:html={CH} /></span>)}
          </span>
          <span class="v-search">Search Google Maps</span>
        </div>
        <div class="v-map">
          <Fragment set:html={MAP} />
          {heroPins.map(([x, y], i) => <i class="vp" style={`left:${x}%;top:${y}%;--i:${i};--c:${colorOf(i)}`} set:html={PIN}></i>)}
          {newPins.map(([x, y], i) => <i class="vp n" style={`left:${x}%;top:${y}%;--i:${i}`} set:html={PIN}></i>)}
          <svg class="v-route" viewBox="0 0 1144 592" preserveAspectRatio="none" aria-hidden="true">
            <polyline pathLength="1" points={routePts.map(([x, y]) => `${x * 11.44},${y * 5.92}`).join(" ")} />
          </svg>
          {routePts.map(([x, y], i) => <b class="vn" style={`left:${x}%;top:${y}%;--i:${i}`}>{i + 1}</b>)}
        </div>
        <aside class="v-panel">
          <div class="v-pb s1">
            <div class="v-ph"><span class="v-pt">Browse · 27 pins</span></div>
            <div class="v-sub"><span>3 left to review</span><span class="tp tp-btn s32"><span class="tp-btxt">Next</span></span></div>
            {places.slice(0, 4).map(([n, s, f, c, r], i) => (
              <div class="v-row" style={`--i:${i}`}><i class="v-th" style={`background-image:url(${im(f)})`}></i>
                <div><b>{n}</b><small>{s}</small><span class="tp tp-badge cat">{c}</span><span class="v-st" set:html={star(r)}></span></div></div>
            ))}
          </div>
          <div class="v-pb s2">
            <div class="v-ph"><span class="v-pt">Research</span></div>
            <div class="v-field"><span class="typed">Best things to do in Kansai</span><i class="caret"></i></div>
            <div class="v-shim"><i></i></div>
            {places.slice(0, 3).map(([n, s, f], i) => (
              <div class="v-row" style={`--i:${i}`}><i class="v-th" style={`background-image:url(${im(f)})`}></i><div><b>{n}</b><small>{s}</small></div><span class={`v-yn ${i === 1 ? "no" : "ok"}`} set:html={i === 1 ? NO : OK}></span></div>
            ))}
          </div>
          <div class="v-pb s3">
            <div class="v-ph"><span class="tp tp-btn tertiary s32 td"><span class="tp-btxt">Kansai trip</span><Fragment set:html={CH} /></span></div>
            <div class="v-rt"><span class="tp tp-cb on"><Fragment set:html={OK} /></span><b>Route 1</b><small>3 stops</small></div>
            {[3, 2, 0].map((p, i) => (
              <Fragment>
                <div class="v-row" style={`--i:${i * 2}`}><i class="v-th sm" style={`background-image:url(${im(places[p][2])})`}></i><div><b>{places[p][0]}</b><small>{places[p][1]}</small></div></div>
                {i < 2 && <div class="v-leg" style={`--i:${i * 2 + 1}`}>{["9 km · 14 min", "6 km · 9 min"][i]}</div>}
              </Fragment>
            ))}
            <div class="v-sum"><span>54 km · 1h 24min</span><span class="tp tp-btn s32"><span class="tp-btxt">Add new</span></span></div>
          </div>
        </aside>
      </div>
    )}

    {name === "problem" && (
      <div class="v-prob">
        <div class="v-pt2"><span class="v-pl">Layers</span><i class="v-x" set:html={NO}></i>
          <div class="v-ly">{Array.from({ length: 10 }).map((_, i) => <b style={`--i:${i};--c:var(--pin-${["purple", "orchid", "pink", "orange", "green", "teal", "blue"][i % 7]})`}></b>)}<b class="no"></b></div></div>
        <div class="v-pt2"><span class="v-pl">Pins</span><i class="v-x" set:html={NO}></i>
