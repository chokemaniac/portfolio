<style is:global>
  .viz { --spring: cubic-bezier(.34, 1.56, .64, 1); --ease: cubic-bezier(.22, 1, .36, 1); position: relative; overflow: hidden; isolation: isolate; border-radius: 48px; background: #e8e7f0; corner-shape: squircle; transition: background .8s; }
  .viz[data-viz="system"].dark { background: #0f0e1d; }
  .viz .stage { position: absolute; left: 50%; top: 50%; width: var(--W); height: var(--H); transform: translate(calc(-50% + var(--ox, 0px)), -50%) scale(var(--s, 1)); transform-origin: center; color: var(--fg); font: 400 14px/1.4 var(--font-sans); }
  .viz .stage * { box-sizing: border-box; }
  .viz:not(.on) * { animation-play-state: paused !important; }
  .viz b { font-weight: 600; } .viz small { display: block; font-size: 11.5px; color: var(--muted); line-height: 1.3; }
  .viz i { font-style: normal; } .viz em { font-style: normal; }
  .viz .v-pl { font-size: 12px; font-weight: 600; letter-spacing: .02em; color: var(--muted); }
  .viz .tp-badge { margin-top: 5px; }
  .viz .tp-btn, .viz .tp-chip { cursor: default; }

  /* app window (hero and planning) */
  .v-win { position: absolute; inset: 28px; border-radius: 24px; overflow: hidden; background: var(--page); box-shadow: 0 30px 70px rgba(24, 22, 56, .2), 0 0 0 1px rgba(24, 22, 56, .06); }
  .v-bar { position: absolute; inset: 0 0 auto 0; height: 60px; z-index: 6; display: flex; align-items: center; gap: 14px; padding: 0 20px; background: var(--bg); border-bottom: 1px solid var(--line); }
  .v-dots { display: flex; gap: 7px; } .v-dots i { width: 11px; height: 11px; border-radius: 50%; background: #ff5f57; } .v-dots i:nth-child(2) { background: #febc2e; } .v-dots i:nth-child(3) { background: #28c840; }
  .v-title { font-weight: 600; font-size: 14px; margin-left: 6px; }
  .v-tabs { position: relative; display: flex; padding: 3px; border-radius: 14px; corner-shape: squircle; background: var(--bg-soft); }
  .v-tabs b { position: relative; z-index: 1; width: 84px; padding: 6px 0; text-align: center; font-size: 13px; font-weight: 500; color: var(--muted); transition: color .3s; }
  .v-tabs u { position: absolute; top: 3px; bottom: 3px; left: 3px; width: 84px; border-radius: 11px; corner-shape: squircle; background: var(--btn-bg); transition: transform .6s var(--spring); }
