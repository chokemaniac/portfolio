  .v-ob .bar { position: relative; display: flex; gap: 6px; margin-top: 18px; } .v-ob .bar i { flex: 1; height: 54px; border-radius: 12px; background: var(--bg-soft); animation: wk 9s infinite var(--spring); animation-delay: calc(var(--i) * .5s); } .v-ob.new .bar i { animation: none; opacity: .25; } .v-ob.new .bar i.on { opacity: 1; background: var(--rust); transform-origin: left; animation: wkn 9s infinite var(--spring); animation-delay: calc(var(--i) * .5s); }
