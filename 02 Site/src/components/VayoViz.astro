  .vp.pvp.l0 { animation: pvl0 10s infinite var(--spring); } .vp.pvp.l1 { animation: pvl1 10s infinite var(--spring); } .vp.pvp.l2 { animation: pvl2 10s infinite var(--spring); }
  @keyframes pvl0 { 0%, 19% { opacity: 0; transform: translateY(-8px) scale(.4); } 21%, 90% { opacity: 1; transform: none; } 96%, 100% { opacity: 0; } }
  @keyframes pvl1 { 0%, 44% { opacity: 0; transform: translateY(-8px) scale(.4); } 46%, 90% { opacity: 1; transform: none; } 96%, 100% { opacity: 0; } }
  @keyframes pvl2 { 0%, 69% { opacity: 0; transform: translateY(-8px) scale(.4); } 71%, 92% { opacity: 1; transform: none; } 97%, 100% { opacity: 0; } }
  /* a hand picks a find up from each source and drags it onto the map, one at a time */
  .pv-hw { position: absolute; left: 0; top: 0; width: 26px; height: 26px; z-index: 6; opacity: 0; animation: pvhand 10s infinite cubic-bezier(.45, 0, .2, 1); }
  .pv-hw svg { position: absolute; inset: 0; width: 26px; height: 26px; fill: #fff; stroke: #202124; stroke-width: 1.1; stroke-linejoin: round; filter: drop-shadow(0 2px 2px rgba(0, 0, 0, .25)); }
  .pv-hw .cover { stroke: none; }
