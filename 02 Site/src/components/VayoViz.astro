<script>
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const spring = (n: number, from: number, to: number) => from + (to - from) * n;

  // each viz is drawn on a fixed stage that is scaled to its box: whole stage on wide boxes, filled and centered on phones
  // typed lines grow to their real width, so the caret travels with the letters
  document.querySelectorAll<HTMLElement>(".vc-ta .typed").forEach((t) => {
    const ctx = document.createElement("canvas").getContext("2d")!;
    ctx.font = getComputedStyle(t).font;
    t.style.setProperty("--tw", Math.ceil(ctx.measureText(t.textContent || "").width) + 2 + "px");
  });
  const fit = (el: HTMLElement) => {
    let W = +el.dataset.w!, H = +el.dataset.h!;
    const w = el.clientWidth, h = el.clientHeight, stage = el.querySelector<HTMLElement>(".stage")!;
    // the playground has to stay usable on a phone, so it stacks into one tall column instead of being cropped
    const mob = ({ system: [560, 1580], outcome: [480, 400] } as Record<string, number[]>)[el.dataset.viz!];
    const stack = !!mob && w < 800;
    if (stack) [W, H] = mob;
    el.classList.toggle("m", stack);
    el.style.aspectRatio = stack ? `${W} / ${H}` : "";
    stage.style.setProperty("--W", W + "px"); stage.style.setProperty("--H", H + "px");
    const s = stack ? w / W : w >= 800 ? Math.min(w / W, h / H) : Math.max(w / W, h / H);
    stage.style.setProperty("--s", String(s));
    // on phones the stage is cropped: the hero and the day plan keep their left side, where the panel is
    const spare = Math.max(0, (W * s - w) / 2), side = el.dataset.align;
    stage.style.setProperty("--ox", `${w < 800 && side === "left" ? spare : w < 800 && side === "right" ? -spare : 0}px`);
  };

  // scenes: the stage gets data-scene="1..n", the CSS does the rest
  const scenes = (stage: HTMLElement, viz: HTMLElement) => {
    const st = (stage.dataset.steps || "").split(",").map(Number).filter(Boolean);
    if (!st.length || reduce) return () => {};
    let i = 0, t = 0;
    const go = () => {
      stage.dataset.scene = String(i + 1);
      if (viz.dataset.viz === "system") { stage.dataset.theme = i % 2 ? "dark" : "light"; viz.classList.toggle("dark", i % 2 === 1); }
      t = window.setTimeout(() => { i = (i + 1) % st.length; go(); }, st[i]);
    };
    go();
    return () => clearTimeout(t);
  };

  // swipe deck: keep or skip, kept places land in the shortlist and get their stars later
  const shortlist = (viz: HTMLElement) => {
    const root = viz.querySelector<HTMLElement>(".v-sl")!;
    let order = [...viz.querySelectorAll<HTMLElement>(".v-sc")];
    const rows = [...viz.querySelectorAll<HTMLElement>(".v-rl")];
    const kept: { n: string; img: string; stars: number; rated: boolean }[] = [];
    const decide = [1, 0, 1, 1, 0, 1, 1, 0, 1];
    let k = 0;
    const draw = () => rows.forEach((r, i) => {
      const e = kept[i];
      r.classList.toggle("show", !!e);
      if (!e) return;
      (r.querySelector(".th") as HTMLElement).style.backgroundImage = `url(${e.img})`;
      r.querySelector("b")!.textContent = e.n;
      r.querySelectorAll(".v-st i").forEach((s, j) => s.classList.toggle("f", e.rated && j < e.stars));
    });
    const layout = () => order.forEach((c, i) => c.style.setProperty("--p", String(i)));
    layout();
    const step = () => {
      const top = order[0], keep = decide[k++ % decide.length];
      top.classList.add(keep ? "r" : "l");
      root.classList.add(keep ? "keepnow" : "skipnow");
      setTimeout(() => root.classList.remove("keepnow", "skipnow"), 450);
      if (keep) {
        const e = { n: top.dataset.n!, img: top.dataset.img!, stars: 3 + (k % 3), rated: false };
        kept.unshift(e); kept.length = Math.min(kept.length, 4);
        draw(); rows[0].classList.remove("pop"); void rows[0].offsetWidth; rows[0].classList.add("pop");
        setTimeout(() => { e.rated = true; draw(); }, 1100);
      }
      setTimeout(() => {
        order.push(order.shift()!);
        top.classList.add("nt"); top.classList.remove("l", "r"); top.style.setProperty("--p", "6");
        void top.offsetWidth; top.classList.remove("nt"); layout();
      }, 640);
    };
    if (reduce) return () => {};
    const id = setInterval(step, 1900);
    return () => clearInterval(id);
  };

  // day plan: the schedule is computed from a start time, the drive legs and the time of stay at each stop;
  // arrivals are rounded up to the next quarter hour, as in the app, and the sunset marker sits where its time falls in the day
  const planning = (viz: HTMLElement) => {
    const win = viz.querySelector<HTMLElement>(".pn-win")!;
    const list = viz.querySelector<HTMLElement>(".pn-list")!;
    const legs = [18, 143, 32, 27], kms = [13, 182, 24, 17], sunset = 16 * 60 + 55;
    const T = (m: number) => `${String(Math.floor(m / 60)).padStart(2, "0")}:${String(m % 60).padStart(2, "0")}`;
    const up15 = (m: number) => Math.ceil(m / 15) * 15;
    const D = (m: number) => (m >= 120 ? `${Math.floor(m / 60)} h ${m % 60} min` : m >= 60 ? `${Math.floor(m / 60)} h ${m % 60} min` : `${m} min`);
    const stayTxt = (m: number) => (m === 0 ? "" : m % 60 === 0 ? `${m / 60}h` : m >= 60 ? `${Math.floor(m / 60)}h ${m % 60}min` : `${m}min`);
    const rows = [...viz.querySelectorAll<HTMLElement>(".pn-row")];
    const marker = viz.querySelector<HTMLElement>(".pn-sun")!, dark = viz.querySelector<HTMLElement>(".pn-dark")!;
    let quiet = false;
    const set = (el: Element | null, txt: string) => { if (el && el.textContent !== txt) { el.textContent = txt; if (quiet) return; el.classList.remove("chg"); void (el as HTMLElement).offsetWidth; el.classList.add("chg"); } };
    const state = { start: 540, ishi: 0 };
    const render = () => {
      const stay = [0, state.ishi, 120, 90, 180];
      const dep: number[] = [state.start], arr: number[] = [state.start];
      for (let i = 0; i < 4; i++) { arr[i + 1] = up15(dep[i] + legs[i]); dep[i + 1] = arr[i + 1] + stay[i + 1]; }
      const x = (t: number) => ((t - 360) / 960) * 100;
      const legEnd = legs.map((m, i) => dep[i] + m);
      const segs = [...viz.querySelectorAll<HTMLElement>(".tl-seg")];
      const spans: [number, number][] = [[dep[0], legEnd[0]], [arr[1], arr[1] + stay[1]], [dep[1], legEnd[1]], [arr[2], arr[2] + stay[2]], [dep[2], legEnd[2]], [arr[3], arr[3] + stay[3]], [dep[3], legEnd[3]], [arr[4], arr[4] + stay[4]]];
      segs.forEach((el, k) => { const [a, b] = spans[k]; el.style.left = x(a) + "%"; el.style.width = Math.max(0, x(b) - x(a)) + "%"; });
      const trk = viz.querySelector<HTMLElement>(".tl-trk")!;
      (trk.querySelector(".tl-sr") as HTMLElement).style.left = x(6 * 60 + 55) + "%"; (trk.querySelector(".tl-ss") as HTMLElement).style.left = x(sunset) + "%"; (trk.querySelector(".tl-night") as HTMLElement).style.left = x(sunset) + "%";
      const late = arr[4] > sunset, st2 = viz.querySelector<HTMLElement>(".tl-st")!;
      st2.classList.toggle("late", late); st2.classList.toggle("ok", !late);
      st2.querySelector("em")!.textContent = late ? "The drive to the hotel is after sunset" : "Everything before sunset";
      set(viz.querySelector(".t-drive"), D(legs.reduce((a, b) => a + b, 0))); set(viz.querySelector(".t-stay"), D(stay.reduce((a, b) => a + b, 0))); set(viz.querySelector(".t-hotel"), "≈" + T(arr[4]));
      const stv = viz.querySelector(".stv"); set(stv, T(state.start));
      legs.forEach((m, i) => {
        const r = viz.querySelector(`.pn-dr[data-l="${i}"]`)!;
        set(r.querySelector(".dd"), T(dep[i])); set(r.querySelector(".da"), "≈" + T(arr[i + 1]));
        set(r.querySelector(".dm"), (i === 0 || i === 3 ? "≈" : "") + D(m)); set(r.querySelector(".dk"), kms[i] + " km");
        r.classList.toggle("dark", arr[i + 1] > sunset);
      });
      const chip = viz.querySelector<HTMLElement>('.pn-st[data-s="1"] .pn-chip')!;
      chip.textContent = state.ishi ? stayTxt(state.ishi) : "Time of stay"; chip.classList.toggle("empty", !state.ishi);
      // where the sunset falls along the day: row by row, from the first departure to the end of the last stay
      const seg: [number, number][] = [[dep[0], dep[0]], [dep[0], arr[1]], [arr[1], dep[1]], [dep[1], arr[2]], [arr[2], dep[2]], [dep[2], arr[3]], [arr[3], dep[3]], [dep[3], arr[4]], [arr[4], arr[4] + 180]];
      let y = rows[rows.length - 1].offsetTop + rows[rows.length - 1].offsetHeight;
      if (sunset < dep[0]) y = rows[0].offsetTop;
      else seg.some(([t0, t1], k) => { if (sunset >= t0 && sunset <= t1) { const r = rows[k]; y = r.offsetTop + (t1 === t0 ? 0 : (sunset - t0) / (t1 - t0)) * r.offsetHeight; return true; } return false; });
      marker.style.transform = `translateY(${Math.round(y - 13 + 30)}px)`;
      const rail = viz.querySelector<HTMLElement>(".pn-rail")!, top = y + 30, bottom = rail.offsetTop + rail.offsetHeight;
      dark.style.top = Math.round(top) + "px"; dark.style.height = Math.max(0, Math.round(bottom - top)) + "px";
    };
    const timers: number[] = [];
    const at = (ms: number, fn: () => void) => timers.push(window.setTimeout(fn, ms));
    const stage = viz.querySelector<HTMLElement>(".stage")!, cur = viz.querySelector<HTMLElement>(".pn-cur")!, dtBtn = viz.querySelector<HTMLElement>(".pn-b.dt")!;
    const point = (el: Element, ox = 0, oy = 0) => {
      const k = parseFloat(getComputedStyle(stage).getPropertyValue("--s")) || 1, r = el.getBoundingClientRect(), w = win.getBoundingClientRect();
      cur.style.transform = `translate(${(r.left + r.width / 2 - w.left) / k + ox}px, ${(r.top + r.height / 2 - w.top) / k + oy}px)`;
    };
    const click = () => { cur.classList.add("click"); setTimeout(() => cur.classList.remove("click"), 450); };
    const reset = () => { win.classList.remove("edit"); win.classList.add("clean"); dtBtn.classList.add("off"); state.start = 540; state.ishi = 0; render(); };
    const open = () => { win.classList.remove("clean"); dtBtn.classList.remove("off"); at(700, render); };
    const close = () => { win.classList.add("clean"); dtBtn.classList.add("off"); };
    // the story starts with the drive times collapsed; the pointer opens them, fills in a stay, changes the start time, and collapses them again
    const run = () => {
      reset();
      cur.style.transition = "none"; cur.style.transform = "translate(900px, 560px)"; void cur.offsetWidth; cur.style.transition = "";
      at(600, () => point(dtBtn, 12, 6));
      at(1700, () => { click(); open(); });
      at(3300, () => point(viz.querySelector(".pn-st[data-s=\"1\"] .pn-chip")!, 18, 4));
      at(4400, click); at(4550, () => { state.ishi = 90; render(); });
      at(7000, () => point(viz.querySelector(".pn-start")!, 14, 4));
      at(8100, () => { click(); win.classList.add("edit"); });
      [[8500, 510], [9000, 480], [9500, 450]].forEach(([ms, v]) => at(ms, () => { state.start = v; render(); }));
      at(10300, () => win.classList.remove("edit"));
      at(11100, () => point(dtBtn, 12, 6));
      at(12200, () => { click(); close(); });
      at(13000, () => point(viz.querySelector(".pn-day")!, 120, 40));
      // back to the very first frame: the pointer returns to where it began and the day is put back while the drive times are collapsed
      at(14200, () => { cur.style.transform = "translate(900px, 560px)"; });
      at(15300, () => { quiet = true; state.start = 540; state.ishi = 0; render(); quiet = false; });
      at(16400, run);
    };
    if (reduce) { win.classList.remove("clean"); dtBtn.classList.remove("off"); state.ishi = 90; render(); return () => {}; }
    render();
    run();
    return () => timers.forEach(clearTimeout);
  };

  // playground: the app's own components, wired the way the app wires them
  const system = (viz: HTMLElement) => {
    const app = viz.querySelector<HTMLElement>(".app")!, q = <T extends HTMLElement>(s: string) => viz.querySelector<T>(s)!, qa = <T extends HTMLElement>(s: string) => [...viz.querySelectorAll<T>(s)];
    const ac = new AbortController(), on = (el: EventTarget, ev: string, fn: (e: any) => void) => el.addEventListener(ev, fn, { signal: ac.signal });
    // tab track: the sliding pill, same code as the app's slide()
    const seg = q(".seg"), sl = q(".seg .slide");
    const slide = () => { const b = seg.querySelector<HTMLElement>("button.on"); if (b) { sl.style.left = b.offsetLeft + "px"; sl.style.width = b.offsetWidth + "px"; } };
    qa<HTMLElement>(".seg button").forEach((b) => on(b, "click", () => { qa(".seg button").forEach((x) => x.classList.toggle("on", x === b)); slide(); }));
    slide(); document.fonts?.ready.then(slide); requestAnimationFrame(() => sl.classList.add("ready"));
    // three-dot menu with Appearance
    const mp = q(".sy-mp"), dots = q(".sy-3");
    const setMenu = (o: boolean) => { mp.classList.toggle("show", o); dots.setAttribute("aria-expanded", String(o)); dots.classList.toggle("on", o); };
    on(dots, "click", (e) => { e.stopPropagation(); setMenu(!mp.classList.contains("show")); });
    on(mp, "click", (e) => e.stopPropagation());
    qa<HTMLElement>(".apt").forEach((box) => [...box.children].forEach((b, k) => on(b, "click", () => {
      [...box.children].forEach((x) => x.classList.toggle("active", x === b)); box.style.setProperty("--i", String(k));
      if (box.hasAttribute("data-th")) { const t = k === 2 ? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light") : k ? "dark" : "light"; app.dataset.theme = t; viz.classList.toggle("dark", t === "dark"); }
    })));
    // pin card: pictures, colour from the palette
    const wrap = q(".pop-imgwrap"), imgs = wrap.dataset.imgs!.split(","), img = q<HTMLImageElement>(".pop-img"), dotsEl = qa(".pop-dots i");
    let n = 0; const show = (d: number) => { n = (n + d + imgs.length) % imgs.length; img.src = imgs[n]; dotsEl.forEach((x, i) => x.classList.toggle("on", i === n)); };
    on(q(".pop-nav.prev"), "click", () => show(-1)); on(q(".pop-nav.next"), "click", () => show(1));
    const pin = q(".sy-pin"), sws = qa<HTMLElement>(".sy-sw");
    sws.forEach((b) => on(b, "click", () => { sws.forEach((x) => x.classList.toggle("on", x === b)); app.style.setProperty("--pc", b.dataset.c!); pin.classList.remove("bump"); void pin.offsetWidth; pin.classList.add("bump"); }));
    // plus menu
    const pm = q(".sy-pm");
    on(q(".tplus"), "click", () => pm.classList.toggle("show"));
    // filter fold-out
    const fo = q(".sy-fo"), fb = q(".sy-fb"), rows = qa<HTMLElement>(".fc");
    const flip = (r: HTMLElement, v?: boolean) => { const cb = r.querySelector<HTMLElement>(".cb")!; const o = v ?? !cb.classList.contains("on"); cb.classList.toggle("on", o); cb.setAttribute("aria-checked", String(o)); };
    on(fb, "click", () => { const o = !fo.classList.contains("show"); fo.classList.toggle("show", o); fb.setAttribute("aria-expanded", String(o)); });
    rows.forEach((r) => on(r, "click", () => flip(r)));
    on(q(".sy-rs"), "click", () => { rows.forEach((r) => flip(r, r.dataset.d === "1")); fb.classList.remove("on"); });
    on(q(".sy-ap"), "click", () => { fb.classList.toggle("on", rows.some((r) => r.querySelector(".cb")!.classList.contains("on") !== (r.dataset.d === "1"))); fo.classList.remove("show"); fb.setAttribute("aria-expanded", "false"); });
    on(document, "click", () => setMenu(false));
    on(document, "keydown", (e) => { if (e.key === "Escape") setMenu(false); });
    return () => ac.abort();
  };

  const runners: Record<string, (v: HTMLElement) => () => void> = { shortlist, planning };
  // the playground is interactive from the start, it does not wait for the scroll observer
  document.querySelectorAll<HTMLElement>(".viz[data-viz=system]").forEach((v) => system(v));
  const io = new IntersectionObserver((es) => es.forEach((e) => {
    const v = e.target as HTMLElement, stop = (v as any)._stop as (() => void) | undefined;
    if (e.isIntersecting && !stop) {
      const s1 = scenes(v.querySelector<HTMLElement>(".stage")!, v), s2 = runners[v.dataset.viz!]?.(v);
      v.classList.add("on");
      (v as any)._stop = () => { s1(); s2?.(); };
    } else if (!e.isIntersecting && stop) { stop(); (v as any)._stop = undefined; v.classList.remove("on"); }
  }), { rootMargin: "80px" });

  document.querySelectorAll<HTMLElement>(".viz").forEach((v) => {
    new ResizeObserver(() => fit(v)).observe(v);
    fit(v);
    io.observe(v);
  });
</script>
