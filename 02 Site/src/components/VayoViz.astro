  .pv-carry { position: absolute; left: 6px; top: -17px; width: 16px; height: 20px; --c: #1e88e5; opacity: 0; animation: pvcarry 10s infinite steps(1); } .pv-carry svg { width: 100%; height: 100%; fill: #1e88e5; stroke: none; }
  @keyframes pvhand {
