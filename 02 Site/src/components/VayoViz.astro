<style is:global>
  .viz { --spring: cubic-bezier(.34, 1.56, .64, 1); --ease: cubic-bezier(.22, 1, .36, 1); position: relative; overflow: hidden; isolation: isolate; border-radius: 48px; background: #e8e7f0; corner-shape: squircle; transition: background .8s; }
