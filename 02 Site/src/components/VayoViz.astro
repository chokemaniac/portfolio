  .pv-sb { height: 28px; margin: 8px; padding: 0 10px; display: flex; align-items: center; background: #fff; box-shadow: 0 1px 4px rgba(60, 64, 67, .3); font-size: 10px; color: #9aa0a6; position: relative; z-index: 2; } .pv-sb span { margin-left: auto; width: 22px; height: 100%; background: #4285f4; margin-right: -10px; }
  .pv-mapi { position: absolute; left: 0; right: 0; top: 44px; bottom: 0; } .pv-mapi .v-bg { position: absolute; inset: 0; width: 100%; height: 100%; }
