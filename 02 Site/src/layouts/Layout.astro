---
import "../styles/global.css";
import { asset, u } from "../data/asset";
import Social from "../components/Social.astro";
const { title = "Mathias Mahling - UX/UI Design Portfolio" } = Astro.props;

const ARCHIVE = "https://chokemaniac.github.io/portfolio/#/screens/467913937/title?browse";
const links = [
  ["Home", "/", ""],
  ["About", "/about", ""],
  ["Viessmann", "/case-study-viessmann", "Case Study"],
  ["Encore", "/case-study-encore", "Case Study"],
  ["Studydrive", "/case-study-studydrive", "Case Study"],
  ["Vayo", "/case-study-vayo", "Case Study"],
  ["Volkswagen", "/showcase-volkswagen", "Showcase"],
  ["Favourites", "/showcase-favourites", "Showcase"],
  ["UX/UI Archive", ARCHIVE, "Showcase"],
];
const heads = { "Case Study": "Case studies", Showcase: "Showcases" };
// a small headline goes in before the first link of each group
const items = links.flatMap((l, j) => (l[2] && l[2] !== links[j - 1]?.[2] ? [{ head: heads[l[2]] }, { l }] : [{ l }]));
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href={asset("16804da32557")} />
    <script is:inline>
      document.documentElement.classList.add("js");
      // a refresh starts at the top instead of jumping back to where you were; back and forward still restore the position
      (function () {
        var nav = performance.getEntriesByType && performance.getEntriesByType("navigation")[0];
        if (nav && nav.type === "reload" && "scrollRestoration" in history) {
          history.scrollRestoration = "manual";
          var top = function () { scrollTo(0, 0); };
          top();
          // some browsers restore the position late, so go to the top again once the page has loaded
          addEventListener("DOMContentLoaded", top);
          addEventListener("load", function () { top(); setTimeout(top, 60); });
          // when leaving the page, hand restoration back to the browser so back and forward keep your place
          addEventListener("pagehide", function () { history.scrollRestoration = "auto"; });
        }
      })();
    </script>
  </head>
  <body>
    <div class="wrap full">
      <header class="header">
        <a href={u("/")}><img class="logo" src={asset("5242da610365")} alt="go to the home page" loading="eager" decoding="async" /></a>
        <button class="menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="menu"><i></i><i></i><i></i></button>
      </header>
    </div>

    <nav class="menu" id="menu" aria-label="Main menu" aria-hidden="true" inert>
      <ol>
        {items.map((it, i) => {
          if (it.head) return <li class="h" style={`--i:${i}`}>{it.head}</li>;
          const [name, href] = it.l;
          const ext = href.startsWith("http");
          const to = ext ? href : u(href);
          return (
            <li style={`--i:${i}`}>
              <a href={to} target={ext ? "_blank" : undefined} rel={ext ? "noopener" : undefined} aria-current={(to.replace(/\/$/, "") || "/") === path ? "page" : undefined}>
                <span class="t">{name}</span>
              </a>
            </li>
          );
        })}
      </ol>
      <div class="menu-foot" style={`--i:${items.length}`}>
        <a href={u("/impressum-datenschutz")}>Impressum &amp; Datenschutz</a>
        <a href="https://www.linkedin.com/in/mathias-mahling-64b3801/">LinkedIn</a>
        <a href="https://www.xing.com/profile/Mathias_Mahling/">Xing</a>
      </div>
    </nav>

    <main><slot /></main>
    <footer class="footer">
      <div class="wrap full">
        <div class="copy">
          <a href={u("/")}><img src={asset("bf9b3af0383c")} alt="go to home page" width="48" height="37" loading="lazy" decoding="async" /></a>
          <span>© 2025 Mathias Mahling - <a href={u("/impressum-datenschutz")}>Impressum &amp; Datenschutz</a></span>
        </div>
        <div class="social">
          <a href="https://www.linkedin.com/in/mathias-mahling-64b3801/" aria-label="LinkedIn"><Social name="linkedin" /></a>
          <a href="https://www.xing.com/profile/Mathias_Mahling/" aria-label="Xing"><Social name="xing" /></a>
        </div>
      </div>
    </footer>

    <script>
      // images fade in once they are fully decoded, instead of painting in from the top while they download
      document.querySelectorAll<HTMLImageElement>("img[loading='lazy']:not(.card > img), .avatar img").forEach((img) => {
        if (img.complete) return img.classList.add("in", "now");
        const show = () => img.classList.add("in");
        // decoding first means the whole picture appears at once; the timeout makes sure nothing stays hidden if decoding is slow
        img.addEventListener("load", () => Promise.race([img.decode ? img.decode().catch(() => {}) : 0, new Promise((r) => setTimeout(r, 700))]).then(show), { once: true });
        img.addEventListener("error", show, { once: true });
      });
      const btn = document.querySelector<HTMLButtonElement>(".menu-btn")!;
      const menu = document.querySelector<HTMLElement>("#menu")!;
      const page = [document.querySelector("main"), document.querySelector(".footer")];
      let ready: number;
      const toggle = (open: boolean) => {
        const r = btn.getBoundingClientRect();
        menu.style.setProperty("--x", `${r.x + r.width / 2}px`);
        menu.style.setProperty("--y", `${r.y + r.height / 2}px`);
        document.documentElement.classList.toggle("menu-open", open);
        btn.setAttribute("aria-expanded", String(open));
        btn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
        menu.setAttribute("aria-hidden", String(!open));
        menu.toggleAttribute("inert", !open);
        page.forEach((el) => el?.toggleAttribute("inert", open));
        clearTimeout(ready);
        document.documentElement.classList.remove("menu-ready");
        if (open) ready = setTimeout(() => document.documentElement.classList.add("menu-ready"), 1100);
        if (open) menu.querySelector<HTMLAnchorElement>("a")?.focus({ preventScroll: true });
        else btn.focus({ preventScroll: true });
      };
      btn.addEventListener("click", () => toggle(btn.getAttribute("aria-expanded") !== "true"));
      menu.addEventListener("click", (e) => { if ((e.target as HTMLElement).closest("a")) toggle(false); });
      document.addEventListener("keydown", (e) => { if (e.key === "Escape" && btn.getAttribute("aria-expanded") === "true") toggle(false); });
    </script>
  </body>
</html>
