---
import Layout from "../layouts/Layout.astro";
import Cta from "../components/Cta.astro";
import Social from "../components/Social.astro";
import Tile from "../components/Tile.astro";
import tools from "../data/tools.json";
import { asset, u } from "../data/asset";

const ARCHIVE = "https://chokemaniac.github.io/portfolio/#/screens/467913937/title?browse";
// logo sizes [w, h] per layout block: desktop / tablet (800 + 640) / mobile
const clients = [
  ["bd9d8d5a0199", "Volkswagen", [40, 40], [32, 32], [27, 27]],
  ["9802a4ee3cfe", "Viessmann", [114, 24], [96, 20], [71, 15]],
  ["bb5c3fbff1b9", "Disney Pictures", [96, 32], [96, 32], [70, 23]],
  ["01808cb33e3a", "Mercedes-Benz", [75, 44], [72, 42], [57, 33]],
  ["cfa0de9ed26c", "Sennheiser", [120, 17], [96, 14], [91, 13]],
  ["c76588b869a9", "ProSiebenSat.1 Media SE", [120, 24], [100, 20], [91, 18]],
];
// listed in the single-column (mobile) order; desktop shows two columns (odd = left, even = right)
const cards = [
  ["Case Study", "Viessmann", "fb9289d7c42b", "/case-study-viessmann"],
  ["Case Study", "Encore", "8f8afc98ed1f", "/case-study-encore"],
  ["Case Study", "Studydrive", "8d4158cb5a13", "/case-study-studydrive"],
  ["Showcase", "Volkswagen", "44ca417a9f3b", "/showcase-volkswagen"],
  ["Showcase", "My Favourite Projects", "437349bdacfd", "/showcase-favourites"],
  ["Showcase", "UX/UI Design Archive", "d296a09324aa", ARCHIVE],
];
const columns = [cards.filter((_, i) => i % 2 === 0), cards.filter((_, i) => i % 2 === 1)];
const services = [
  ["layers", "Product Design", "User research, analysis, prototyping, turning ideas into working products."],
  ["devices", "Web & App Design", "Ideation, wireframing, UI Design, interactions, developer handover."],
  ["pencil", "Design Systems", "Component libraries, guidelines, tokens, scalable design foundations."],
  ["accessibility", "Accessibility", "WCAG compliance, keyboard and screen reader, no user left behind."],
  ["chart", "Data Analysis", "Data-informed product decisions through user behaviour insights and KPI tracking."],
  ["head-gear", "Consultation", "Improving usability and design quality by design reviews and strategic UX/UI guidance."],
];
---
<Layout>
  <div class="wrap hero-wrap"><div class="inner">
    <section class="hero">
      <div class="who">
        <div class="avatar"><img src={asset("4abf805abe78")} alt="mathias mahling" /></div>
        <div>
          <h2>Mathias Mahling</h2>
          <div class="badge"><i></i>Limited project availability</div>
        </div>
      </div>
      <h1>Digital Product Designer specialising in complex user interfaces.</h1>
      <p class="lead">Strong passion for clean and intelligent interfaces. Fintech friendly. Innovation hungry. Digital native.</p>
      <div class="clients">
        {clients.map(([f, alt, d, t, m]) => <img src={asset(f)} alt={alt} width={d[0]} height={d[1]} style={`--w:${d[0]};--h:${d[1]};--tw:${t[0]};--th:${t[1]};--mw:${m[0]};--mh:${m[1]}`} />)}
      </div>
    </section>
  </div></div>

  <div class="wrap full grid-wrap">
    <section class="grid">
      {columns.map((col) => (
        <div class="col">
          {col.map(([kind, name, img, href]) => {
            const ext = href.startsWith("http");
            return (
              <a class="card" href={ext ? href : u(href)} target={ext ? "_blank" : undefined} rel={ext ? "noopener" : undefined} style={`order:${cards.findIndex((c) => c[1] === name)}`}>
                <img src={asset(img)} alt="" loading="lazy" />
                <p class="kind">{kind}</p>
                <p class="name">{name}{name === "Volkswagen" && <span class="ag"> AG</span>}</p>
                <span class="go"><img src={asset("ed6156525815")} alt="" /></span>
              </a>
            );
          })}
        </div>
      ))}
    </section>
  </div>

  <div class="wrap"><div class="inner">
    <section class="services">
      <h2 class="label">Services</h2>
      <div class="svc-grid">
        {services.map(([ic, t, p]) => (
          <div class="svc">
            <Tile name={ic} cls="ic" />
            <div><h3>{t}</h3><p>{p}</p></div>
          </div>
        ))}
      </div>
    </section>

    <section class="about">
      <div>
        <h2 class="label">About</h2>
        <h2 class="h2">I love bringing clear, consistent structure and a polished UI to everyday digital products.</h2>
        <div class="stats">
          <div><b>10+</b><span>Years of experience</span></div>
          <div><b>200+</b><span>Projects delivered</span></div>
        </div>
        <div class="actions">
          <a class="btn" href={u("/about")}>More about me</a>
          <a class="btn btn-icon" href="https://www.linkedin.com/in/mathias-mahling-64b3801/" aria-label="LinkedIn"><Social name="linkedin" /></a>
          <a class="btn btn-icon" href="https://www.xing.com/profile/Mathias_Mahling/" aria-label="Xing"><Social name="xing" /></a>
        </div>
      </div>
      <div>
        <h2 class="label">Main Tools</h2>
        <div class="tools">
          {tools.map((t) => (
            <div class="tool" title={t.name}>
              <div class="g">
                {t.imgs.map(([f, x, y, w, h]) => <img src={asset(f)} alt="" style={`left:${x}px;top:${y}px;width:${w}px;height:${h}px`} />)}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </div></div>

  <Cta />
</Layout>

<style is:global>
  .hero { padding-top: 49px; }
  /* the intro block stays where it is while the page scrolls and fades out as scrolling starts; everything after it slides over it */
  .hero-wrap { position: sticky; top: var(--pin, 0px); z-index: 0; }
  main > :not(.hero-wrap) { position: relative; z-index: 1; }
  /* the logo and menu button are pinned and faded with the intro; an open menu always keeps its close button */
  .header-pin { position: sticky; top: 0; z-index: 60; }
  .menu-open .header-pin { opacity: 1 !important; pointer-events: auto !important; }
  .who { display: flex; gap: 24px; align-items: flex-start; }
  .avatar { width: 88px; height: 88px; border-radius: 24px; overflow: hidden; flex: none; }
  .avatar img { width: 231.8%; max-width: none; margin-left: -55.7%; }
  .who h2 { font-size: 28px; font-weight: 600; letter-spacing: -1.12px; margin-top: 5px; line-height: 35px; }
  .badge { display: inline-flex; align-items: center; gap: 14px; height: 36px; margin-top: 8px; padding: 0 13px; background: #fff; border-radius: 40px; font-size: 14px; line-height: 24px; }
  .badge i { width: 10px; height: 10px; border-radius: 50%; background: #fdad00; box-shadow: 0 0 0 3px rgba(253, 173, 0, .2); }
  .hero h1 { font-size: 48px; font-weight: 600; letter-spacing: -1.92px; color: #000; max-width: 688px; margin-top: 40px; }
  .lead { font-size: 24px; line-height: 36px; color: var(--muted); max-width: 706px; margin-top: 24px; }
  .clients { display: flex; flex-wrap: wrap; align-items: center; gap: 24px 44px; margin-top: 40px; }
  .clients img { width: calc(var(--w) * 1px); height: calc(var(--h) * 1px); max-width: none; }

  .grid { display: flex; gap: 32px; margin-top: 120px; }
  .col { display: flex; flex-direction: column; gap: 32px; flex: 1; min-width: 0; }
  /* how much lower the right column starts than the left one: the original measurement, made 20% bigger */
  .col + .col { margin-top: calc((32.7px + (100vw - 192px) * .0345) * 1.2); }
  .card { --cx: 32px; --ct: 32px; --nt: 23px; position: relative; display: block; width: 100%; aspect-ratio: 1; border-radius: 56px; overflow: hidden; color: #fff; }
  .card > img { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; object-fit: cover; }
  .card .kind { position: absolute; left: var(--cx); top: var(--ct); font-size: 12px; letter-spacing: -.48px; }
  .card .name { position: absolute; left: var(--cx); top: calc(var(--ct) + var(--nt)); font-size: 22px; font-weight: 600; letter-spacing: -.88px; line-height: 28px; }
  .card .go { position: absolute; left: var(--cx); top: calc(var(--ct) + 59px); width: 36px; height: 36px; border-radius: 112px; background: rgba(255, 255, 255, .15); display: grid; place-items: center; }
  .card .go img { width: 12px; height: 10px; }
  .ag { display: none; }

  .services { margin-top: 80px; }
  .svc-grid { display: grid; grid-template-columns: 1fr 1fr; margin: 40px -14px 0 -10px; row-gap: 76px; }
  .svc { padding-right: 54px; }
  .svc > div { padding-bottom: 9px; }
  .svc .ic { align-self: center; }

  .about { display: grid; grid-template-columns: 1fr 1fr; gap: 46px; margin-top: 106px; }
  .about .label { margin-bottom: 24px; }
  .about .h2 { max-width: 589px; }
  .stats { display: flex; gap: 24px; margin-top: 24px; }
  .stats b { display: block; font-size: 56px; line-height: 56px; font-weight: 700; letter-spacing: -3.36px; color: var(--ink-2); }
  .stats span { display: block; font-size: 18px; font-weight: 600; letter-spacing: -.36px; color: var(--ink-2); margin-top: 4px; }
  .about .actions .btn:first-child { width: 172px; padding: 0; }
  .tools { --s: 1; display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px 12.5px; }
  .tool { position: relative; width: 100%; height: 110px; border-radius: 16px; background: rgba(255, 255, 255, .6); overflow: hidden; box-shadow: 0 2px 12px rgba(0, 0, 0, .08); }
  .tool .g { position: absolute; left: 50%; top: 0; width: 188px; height: 110px; margin-left: -94px; transform: scale(var(--s)); }
  .tool img { position: absolute; max-width: none; }

  /* motion: staggered hero entrance, scroll reveals, card hover, pulsing availability dot */
  @keyframes rise { from { opacity: 0; transform: translateY(24px); } }
  @keyframes pulse { 50% { box-shadow: 0 0 0 7px rgba(253, 173, 0, 0); } }
  .hero > * { animation: rise .9s cubic-bezier(.2, .7, .2, 1) backwards; }
  .hero h1 { animation-delay: .1s; }
  .lead { animation-delay: .2s; }
  .clients { animation-delay: .3s; }
  .badge i { animation: pulse 2s ease-in-out infinite; }
  .card > img { transition: transform .8s cubic-bezier(.2, .7, .2, 1); }
  .card:hover > img { transform: scale(1.05); }
  .card .go { transition: transform .4s cubic-bezier(.2, .7, .2, 1), background .3s; }
  .card:hover .go { transform: translateX(6px); background: rgba(255, 255, 255, .3); }
  /* tiles slide up from below as they come into view (the script adds .in); the right column follows a beat later */
  .js .card { opacity: 0; transform: translateY(90px); transition: opacity .7s ease, transform 1s cubic-bezier(.2, .7, .2, 1); }
  .js .card.in { opacity: 1; transform: none; }
  .js .col + .col .card { transition-delay: .12s; }
  .col { will-change: transform; }
  .tool { transition: transform .3s cubic-bezier(.2, .7, .2, 1); }
  .tool:hover { transform: translateY(-4px); }
  @supports (animation-timeline: view()) {
    .svc, .about > div, .stats > div {
      animation: rise linear both; animation-timeline: view(); animation-range: entry 0% entry 60%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero > *, .badge i, .svc, .about > div, .stats > div { animation: none !important; }
    .card > img, .card .go, .tool, .js .card { transition: none; }
  }

  /* widest layout (1623+): cards grow between margins that scale from 80px to 200px (--edge), bigger hero */
  @media (min-width: 1623px) {
    .wrap.grid-wrap { padding-inline: var(--edge); }
    .col + .col { margin-top: calc(((100vw - 2 * var(--edge) - 32px) * .02675 + 32px) * 1.2); }
    .card .name { font-size: 24px; letter-spacing: -.96px; line-height: normal; }
    .card .go { top: calc(var(--ct) + 62px); }
    .avatar { width: 96px; height: 96px; }
    .who h2 { font-size: 32px; letter-spacing: -1.28px; line-height: normal; margin-top: 6px; }
    .badge { margin-top: 7px; }
    .hero h1 { font-size: 56px; letter-spacing: -2.24px; max-width: 808px; }
    .services { margin-top: 100px; }
    .svc-grid { margin-top: 46px; }
    .svc h3 { margin-top: 16px; }
    .svc:nth-child(-n+2) { margin-bottom: 12px; }
    .about { margin-top: 113px; }
  }

  /* 800 block (800-1099): single column */
  @media (max-width: 1099px) {
    .hero { padding-top: 0; }
    .avatar { width: 80px; height: 80px; }
    .who h2 { font-size: 24px; letter-spacing: -.96px; line-height: normal; margin-top: 3px; }
    .badge { font-size: 13px; margin-top: 7px; }
    .hero h1 { font-size: 40px; letter-spacing: -1.6px; max-width: 660px; }
    .lead { font-size: 22px; line-height: 32px; max-width: 640px; }
    .clients { gap: 24px 40px; }
    .clients img:nth-child(5) { order: 6; } /* on tablet and phone ProSiebenSat.1 comes before Sennheiser, as on the old site */
    .clients img { width: calc(var(--tw) * 1px); height: calc(var(--th) * 1px); }

    .grid { flex-direction: column; gap: 32px; }
    .col { display: contents; }
    .col + .col { margin-top: 0; }
    .card { --cx: 40px; --ct: 40px; }
    .card .name { font-size: 24px; letter-spacing: -.96px; }

    .services { margin-top: 100px; }
    .svc-grid { row-gap: 74px; }
    .svc { padding-right: 30px; }
    .svc > div { padding-bottom: 0; }
    .svc .ic { align-self: flex-start; }
    .svc .ic { width: 108px; height: 108px; }
    .svc h3 { font-size: 22px; letter-spacing: -.88px; margin-top: 6px; }
    .tool:nth-child(9) { display: none; }
    .ic-tile > span { width: 88px; height: 88px; }
    .ic-tile > span > svg { width: 55px; height: 55px; }

    .about { grid-template-columns: 1fr; gap: 100px; margin-top: 100px; }
    .about > div:first-child { max-width: 600px; }
    .about .h2 { max-width: none; }
    .tools { grid-template-columns: repeat(4, 1fr); }
  }
  /* in the 800 block the third service has a larger icon */
  @media (min-width: 800px) and (max-width: 1099px) {
    .svc:nth-child(3) .ic { width: 124px; height: 124px; }
    .svc .ic { margin-bottom: -14px; }
  }
  /* 640 block (640-799): single column services, narrower text */
  @media (max-width: 799px) {
    .hero h1 { max-width: 703px; }
    .lead { font-size: 20px; line-height: 30px; max-width: 526px; }
    .svc h3 { font-size: 24px; letter-spacing: -.96px; }
    .svc-grid { grid-template-columns: 1fr; row-gap: 44px; }
    .clients { gap: 32px 44px; }
    .svc { padding-right: 54px; gap: 14px; }
    .svc .ic { width: 130px; height: 130px; }
    .svc h3 { margin-top: 13px; }
    .svc .ic-tile { height: 88px; --s: 1.0484; }
    .ic-tile > span { width: 104px; height: 104px; }
    .ic-tile > span > svg { width: 65px; height: 65px; }
    .tools { grid-template-columns: repeat(3, 1fr); }
  }
  /* at 640-642px the last service text wraps to 3 lines and the live layout pulls that row up by 7px */
  @media (min-width: 640px) and (max-width: 642px) {
    .svc:last-child { margin-top: -7px; }
  }
  /* mobile block (<640) */
  @media (max-width: 639px) {
    .who { gap: 16px; }
    .avatar { width: 64px; height: 64px; }
    .who h2 { font-size: 20px; letter-spacing: -.8px; margin-top: 2px; }
    .badge { font-size: 11px; height: 31px; margin-top: 3px; padding: 0 12px; gap: 12px; }
    .hero h1 { font-size: 26px; letter-spacing: -1.04px; max-width: 470px; }
    .lead { font-size: 17px; line-height: 26px; max-width: 470px; }
    .clients { gap: 24px; }
    .clients img { width: calc(var(--mw) * 1px); height: calc(var(--mh) * 1px); }

    .grid { margin-top: 67px; }
    .card { --cx: 20px; --ct: 24px; }
    .card .name { font-size: 20px; letter-spacing: -.8px; line-height: 26px; }
    .card .go { top: calc(var(--ct) + 57px); }
    .ag { display: inline; }

    .svc-grid { row-gap: 59px; }
    .svc h3 { margin-top: 6px; }
    .svc { padding-right: 14px; gap: 14px; }
    .svc .ic { width: 84px; height: 84px; }
    .svc h3 { font-size: 24px; letter-spacing: -.96px; }
    .tool:nth-child(9) { display: block; }
    .tool:nth-child(8) { display: none; }
    .svc .ic-tile { --s: .7778; }
    .ic-tile > span { width: 88px; height: 88px; }
    .ic-tile > span > svg { width: 55px; height: 55px; }

    .about { gap: 80px; margin-top: 80px; }
    .about .h2 { font-size: 24px; line-height: normal; letter-spacing: -.72px; }
    .stats { margin-top: 32px; }
    .stats b { font-size: 48px; letter-spacing: -2.88px; }
    .stats span { font-size: 15px; letter-spacing: -.3px; }
    .tools { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
  }
</style>

<script>
  // intro block: pinned at its own place (--pin = its distance from the top) and faded out over the first 280px of scrolling
  const heroWrap = document.querySelector<HTMLElement>(".hero-wrap");
  if (heroWrap && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const main = heroWrap.parentElement!; // the intro is main's first child, so main's top is where the intro naturally sits
    const pin = () => heroWrap.style.setProperty("--pin", `${main.getBoundingClientRect().top + scrollY}px`);
    let heroTick = 0;
    const bar = document.querySelector<HTMLElement>(".header")?.parentElement; // logo and menu button
    bar?.classList.add("header-pin");
    const fade = () => {
      const o = Math.max(0, 1 - scrollY / 280);
      for (const el of [heroWrap, bar]) if (el) { el.style.opacity = String(o); el.style.pointerEvents = o === 0 ? "none" : ""; }
    };
    pin();
    fade();
    addEventListener("scroll", () => { cancelAnimationFrame(heroTick); heroTick = requestAnimationFrame(fade); }, { passive: true });
    addEventListener("resize", pin);
  } else heroWrap?.style.setProperty("position", "static");

  // project tiles: slide up into place as they appear, and the right column drifts upward faster than the left one (it starts lower and ends higher)
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const cards = document.querySelectorAll<HTMLElement>(".card");
  if (reduce) cards.forEach((c) => c.classList.add("in"));
  else {
    // a tile waits 90px lower while hidden. It starts sliding once its real spot is LEAD px above the bottom of the screen:
    // 130px on wide screens, and less on tall ones (portrait tablets and phones) so the tiles show up sooner there
    const reveal = (card: Element) => {
      // the tile starts sliding once its picture has loaded (or after a second), so the picture slides in with it
      const img = card.querySelector<HTMLImageElement>(":scope > img");
      const go = () => card.classList.add("in");
      if (!img || img.complete) return go();
      Promise.race([new Promise((r) => img.addEventListener("load", r, { once: true })), new Promise((r) => setTimeout(r, 1000))]).then(go);
    };
    const waiting = [...cards];
    const check = (lead: number) => {
      for (const c of [...waiting]) {
        if (c.getBoundingClientRect().top - 90 < innerHeight - lead) { reveal(c); waiting.splice(waiting.indexOf(c), 1); }
      }
    };
    const lead = () => { const a = innerWidth / innerHeight; return a >= 1 ? 130 : 130 * a * a; };
    check(0); // tiles already on screen when the page opens slide in right away
    let revealTick = 0;
    const onScroll = () => { cancelAnimationFrame(revealTick); revealTick = requestAnimationFrame(() => check(lead())); };
    addEventListener("scroll", onScroll, { passive: true });
    addEventListener("resize", onScroll);
    const grid = document.querySelector<HTMLElement>(".grid");
    const right = document.querySelectorAll<HTMLElement>(".grid > .col")[1];
    const DRIFT = 190; // px the right column travels more than the page does while the grid passes through the screen (it starts in its normal place, lower than the left column, and ends this much higher)
    if (grid && right) {
      const update = () => {
        if (getComputedStyle(right).display === "contents") return void (right.style.transform = "");
        // 0 at the top of the page (both columns start exactly where the layout puts them), 1 when the bottom of the grid reaches the bottom of the screen
        const end = scrollY + grid.getBoundingClientRect().bottom - innerHeight;
        const t = end > 0 ? Math.min(1, Math.max(0, scrollY / end)) : 0;
        right.style.transform = `translate3d(0, ${(-t * DRIFT).toFixed(1)}px, 0)`;
      };
      let tick = 0;
      addEventListener("scroll", () => { cancelAnimationFrame(tick); tick = requestAnimationFrame(update); }, { passive: true });
      addEventListener("resize", update);
      update();
    }
  }

  // scale the tool logos with their tile (tiles are fluid, logos are laid out for a 188px tile)
  const tools = document.querySelector<HTMLElement>(".tools");
  if (tools) new ResizeObserver(() => tools.style.setProperty("--s", String(Math.min(1, tools.firstElementChild!.clientWidth / 188)))).observe(tools);
</script>
